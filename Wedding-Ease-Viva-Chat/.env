# Firebase Client SDK — copy to .env and fill in values from Firebase Console
# Project Settings → General → Your apps → Web app → SDK setup and configuration

VITE_API_BASE_URL=http://localhost:3001
# VITE_API_BASE_URL = https://backend.theweddingbot.ai
# 
VITE_EXCHANGE_RATE_API_KEY=ce1384b9a93b5aad0e758d61
VITE_IP_GEOLOCATION_API_KEY=f92eea25a17246a09563543976ca23d7

VITE_POSTHOG_KEY=phc_C3dxDiWMwVzdTWbXbDXvp98L9XCm2qFTJtcgxenkkBXV
# Reverse proxy path served by the backend. Keeps requests same-origin and bypasses ad-blockers.
VITE_POSTHOG_HOST=/ingest
# Hard kill-switch. Set to "true" to enable capture.
VITE_POSTHOG_ENABLED=true
# Optional build version tag sent as super property
VITE_APP_VERSION=dev

# Payment gateway control. Set to "true" to enable PayU payment flow, "false" to skip payment (direct plan activation)
VITE_ENABLE_PAYMENT=true


