# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── Firebase Admin — service account credentials ──────────────────────────────
# Path to your downloaded service account JSON from Firebase Console:
# Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── Pipeline toggle ──────────────────────────────────────────────────────────
# true  → full pipeline: STT + language detection + translation (both inbound & outbound)
# false → skip STT & translation; treat all input as English, return English response
ENABLE_SPEECH_TRANSLATION=true

# ── Azure AI Foundry — GPT-4o ────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://weddingease.openai.azure.com
AZURE_OPENAI_API_KEY=5vbFY3lJ11aWuE0qXLspge5kIhdx6qhBJtMdWX9EmTD7Zcmm5ODIJQQJ99CCACYeBjFXJ3w3AAABACOGZAE3
AZURE_DEPLOYMENT_NAME=gpt-4o

# ── Azure AI Speech — STT + Continuous Language ID ───────────────────────────
# Get from: Azure Portal → Speech resource → Keys and Endpoint
AZURE_SPEECH_KEY=6AxYp0hF2Z4tfoaB7vMQbVk6UkWTCpDYEVzMotPhnAK2JfLnV2EZJQQJ99CCACYeBjFXJ3w3AAAYACOGMC92
AZURE_SPEECH_REGION=eastus

# ── Azure AI Translator ───────────────────────────────────────────────────────
# Get from: Azure Portal → Translator resource → Keys and Endpoint
AZURE_TRANSLATOR_KEY=6ayHkt1b5pKeT2LRzKydNMVocg8g0s7cA64PD38BngjBkuq3s4pnJQQJ99CCACYeBjFXJ3w3AAAbACOGva5K
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=eastus

# ── Google Gemini — Image Generation (Imagen 3) ──────────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCWjZDU2tObDolSFAHQUdWP3I08XXCRrmI

# ── Web Search — Google Custom Search + Bing fallback ────────────────────────
# Google: console.cloud.google.com → Custom Search JSON API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Bing: portal.azure.com → Bing Search resource → Keys
BING_SEARCH_API_KEY=
