# Backend API
VITE_API_BASE_URL=http://localhost:3001

# Firebase Client SDK — copy to .env and fill in values from Firebase Console
# Project Settings → General → Your apps → Web app → SDK setup and configuration
# Dev/prod split: unsuffixed on purpose — set these in Vercel's dashboard
# scoped per environment (Production = wedding-ease-dc99a values, Preview =
# weddingease-1 values) rather than committing two value sets here. The
# browser console logs the active projectId on any non-prod build so you can
# confirm which Firebase project a given deployment loaded.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Currency / geolocation (Vite) ---
VITE_EXCHANGE_RATE_API_KEY=
VITE_IP_GEOLOCATION_API_KEY=f92eea25a17246a09563543976ca23d7

# --- Subscription + top-up prices (USD, display only) ---
# Must mirror the backend's PRO / PRO_ANNUAL / PRO_MAX / PRO_MAX_ANNUAL / TOPUP,
# or the displayed price won't match the charged price. Unset => shipped default
# (shown in the comment). Baked in at build time — rebuild after changing.
VITE_PRO=10                 # Pro monthly
VITE_PRO_ANNUAL=79          # Pro annual
VITE_PRO_MAX=39             # Pro Max monthly
VITE_PRO_MAX_ANNUAL=299     # Pro Max annual
VITE_TOPUP=10               # one-time 2M-token top-up pack

# --- PostHog analytics (client) ---
# Project key from app.posthog.com → Project Settings. Only phc_* public keys here.
VITE_POSTHOG_KEY=
# Reverse proxy path served by the backend. Keeps requests same-origin and bypasses ad-blockers.
VITE_POSTHOG_HOST=/ingest
# Hard kill-switch. Must be "true" AND PROD build for capture to fire.
VITE_POSTHOG_ENABLED=false
# Optional build version tag sent as super property
VITE_APP_VERSION=dev
