          ],
          "content": {
            "size": -1,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <script type=\"module\">import { injectIntoGlobalHook } from \"/@react-refresh\";\ninjectIntoGlobalHook(window);\nwindow.$RefreshReg$ = () => {};\nwindow.$RefreshSig$ = () => (type) => type;</script>\n\n    <script type=\"module\" src=\"/@vite/client\"></script>\n\n    <meta charset=\"UTF-8\" />\n    <!-- Theme boot — runs before React mounts to kill the theme-swap flash\n         on cold reload. Reads the persisted theme synchronously and applies\n         either the `light` or `dark` class to <html>. Default is `light`.\n         Also sets color-scheme so native form controls / scrollbars track. -->\n    <script>\n      (function () {\n        try {\n          var t = localStorage.getItem('easebot-theme');\n          if (t !== 'system' && t !== 'light' && t !== 'dark') t = 'light';\n          var resolved = t;\n          if (t === 'system') {\n            resolved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';\n          }\n          var root = document.documentElement;\n          root.classList.toggle('dark', resolved === 'dark');\n          root.classList.toggle('light', resolved === 'light');\n          root.style.colorScheme = resolved;\n        } catch (e) { /* private mode / no storage */ }\n      })();\n    </script>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover\" />\n    <link rel=\"icon\" type=\"image/png\" href=\"/images/typo.png\" />\n    <link rel=\"apple-touch-icon\" href=\"/images/typo.png\" />\n    <title>TheWeddingBot - Your Personal Wedding Planning Assistant</title>\n    <meta name=\"description\" content=\"TheWeddingBot helps you plan your perfect wedding with personalized guidance, expert tips, and 24/7 support.\" />\n    <meta name=\"author\" content=\"TheWeddingBot\" />\n\n    <!-- Mobile browser chrome color (Android Chrome / Safari iOS 15+) -->\n    <meta name=\"theme-color\" content=\"#3A0E20\" />\n    <!-- color-scheme is set dynamically by the boot script above so native\n         form controls / scrollbars track the active theme. -->\n    <meta name=\"color-scheme\" content=\"light dark\" />\n\n    <!-- iOS PWA / add-to-home-screen -->\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"TheWeddingBot\" />\n    <meta name=\"format-detection\" content=\"telephone=no\" />\n\n    <!-- Google Fonts (Stitch: Noto Serif + Inter) -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <!-- Material Symbols (Stitch icon set) -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap\" rel=\"stylesheet\">\n\n    <!-- Preload background image for immediate loading -->\n    <link rel=\"preload\" href=\"/images/IMG_3917.PNG\" as=\"image\" type=\"image/png\" />\n\n    <meta property=\"og:title\" content=\"TheWeddingBot - Your Personal Wedding Planning Assistant\" />\n    <meta property=\"og:description\" content=\"TheWeddingBot helps you plan your perfect wedding with personalized guidance, expert tips, and 24/7 support.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:image\" content=\"https://theweddingbot.ai/images/easebot.png\" />\n    <meta property=\"og:image:secure_url\" content=\"https://theweddingbot.ai/images/easebot.png\" />\n    <meta property=\"og:image:type\" content=\"image/png\" />\n    <meta property=\"og:image:width\" content=\"275\" />\n    <meta property=\"og:image:height\" content=\"300\" />\n    <meta property=\"og:image:alt\" content=\"TheWeddingBot mascot\" />\n    <meta property=\"og:url\" content=\"https://theweddingbot.ai/\">\n    <meta property=\"og:site_name\" content=\"TheWeddingBot\" />\n\n    <meta name=\"twitter:card\" content=\"summary\" />\n    <meta name=\"twitter:site\" content=\"@weddingease_ai\" />\n    <meta name=\"twitter:title\" content=\"TheWeddingBot - Your Personal Wedding Planning Assistant\" />\n    <meta name=\"twitter:description\" content=\"TheWeddingBot helps you plan your perfect wedding with personalized guidance, expert tips, and 24/7 support.\" />\n    <meta name=\"twitter:image\" content=\"https://theweddingbot.ai/images/easebot.png\" />\n\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <link rel=\"canonical\" href=\"https://theweddingbot.ai/\">\n\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"TheWeddingBot\",\n      \"applicationCategory\": \"LifestyleApplication\",\n      \"operatingSystem\": \"Web\",\n      \"description\": \"TheWeddingBot — AI-powered wedding planning assistant with personalized guidance, style recommendations, budget tracking, and 24/7 support.\",\n      \"offers\": [\n        {\n          \"@type\": \"Offer\",\n          \"price\": \"0\",\n          \"priceCurrency\": \"USD\",\n          \"name\": \"Free\"\n        },\n        {\n          \"@type\": \"Offer\",\n          \"price\": \"1\",\n          \"priceCurrency\": \"INR\",\n          \"name\": \"Pro\"\n        },\n        {\n          \"@type\": \"Offer\",\n          \"price\": \"39\",\n          \"priceCurrency\": \"USD\",\n          \"name\": \"Pro Max\"\n        }\n      ],\n      \"author\": {\n        \"@type\": \"Organization\",\n        \"name\": \"TheWeddingBot\",\n        \"url\": \"https://theweddingbot.ai\"\n      }\n    }\n    </script>\n  </head>\n\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n"
          },
