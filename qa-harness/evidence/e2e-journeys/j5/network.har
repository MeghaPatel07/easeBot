family by default.\\n5. Use the user's configured `sans` font-feature-settings by default.\\n6. Use the user's configured `sans` font-variation-settings by default.\\n7. Disable tap highlights on iOS\\n*/\\n\\nhtml,\\n:host {\\n  line-height: 1.5; /* 1 */\\n  -webkit-text-size-adjust: 100%; /* 2 */\\n  -moz-tab-size: 4; /* 3 */\\n  -o-tab-size: 4;\\n     tab-size: 4; /* 3 */\\n  font-family: ui-sans-serif, system-ui, sans-serif, \\\"Apple Color Emoji\\\", \\\"Segoe UI Emoji\\\", \\\"Segoe UI Symbol\\\", \\\"Noto Color Emoji\\\"; /* 4 */\\n  font-feature-settings: normal; /* 5 */\\n  font-variation-settings: normal; /* 6 */\\n  -webkit-tap-highlight-color: transparent; /* 7 */\\n}\\n\\n/*\\n1. Remove the margin in all browsers.\\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\\n*/\\n\\nbody {\\n  margin: 0; /* 1 */\\n  line-height: inherit; /* 2 */\\n}\\n\\n/*\\n1. Add the correct height in Firefox.\\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\\n3. Ensure horizontal rules are visible by default.\\n*/\\n\\nhr {\\n  height: 0; /* 1 */\\n  color: inherit; /* 2 */\\n  border-top-width: 1px; /* 3 */\\n}\\n\\n/*\\nAdd the correct text decoration in Chrome, Edge, and Safari.\\n*/\\n\\nabbr:where([title]) {\\n  -webkit-text-decoration: underline dotted;\\n          text-decoration: underline dotted;\\n}\\n\\n/*\\nRemove the default font size and weight for headings.\\n*/\\n\\nh1,\\nh2,\\nh3,\\nh4,\\nh5,\\nh6 {\\n  font-size: inherit;\\n  font-weight: inherit;\\n}\\n\\n/*\\nReset links to optimize for opt-in styling instead of opt-out.\\n*/\\n\\na {\\n  color: inherit;\\n  text-decoration: inherit;\\n}\\n\\n/*\\nAdd the correct font weight in Edge and Safari.\\n*/\\n\\nb,\\nstrong {\\n  font-weight: bolder;\\n}\\n\\n/*\\n1. Use the user's configured `mono` font-family by default.\\n2. Use the user's configured `mono` font-feature-settings by default.\\n3. Use the user's configured `mono` font-variation-settings by default.\\n4. Correct the odd `em` font sizing in all browsers.\\n*/\\n\\ncode,\\nkbd,\\nsamp,\\npre {\\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \\\"Liberation Mono\\\", \\\"Courier New\\\", monospace; /* 1 */\\n  font-feature-settings: normal; /* 2 */\\n  font-variation-settings: normal; /* 3 */\\n  font-size: 1em; /* 4 */\\n}\\n\\n/*\\nAdd the correct font size in all browsers.\\n*/\\n\\nsmall {\\n  font-size: 80%;\\n}\\n\\n/*\\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\\n*/\\n\\nsub,\\nsup {\\n  font-size: 75%;\\n  line-height: 0;\\n  position: relative;\\n  vertical-align: baseline;\\n}\\n\\nsub {\\n  bottom: -0.25em;\\n}\\n\\nsup {\\n  top: -0.5em;\\n}\\n\\n/*\\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\\n3. Remove gaps between table borders by default.\\n*/\\n\\ntable {\\n  text-indent: 0; /* 1 */\\n  border-color: inherit; /* 2 */\\n  border-collapse: collapse; /* 3 */\\n}\\n\\n/*\\n1. Change the font styles in all browsers.\\n2. Remove the margin in Firefox and Safari.\\n3. Remove default padding in all browsers.\\n*/\\n\\nbutton,\\ninput,\\noptgroup,\\nselect,\\ntextarea {\\n  font-family: inherit; /* 1 */\\n  font-feature-settings: inherit; /* 1 */\\n  font-variation-settings: inherit; /* 1 */\\n  font-size: 100%; /* 1 */\\n  font-weight: inherit; /* 1 */\\n  line-height: inherit; /* 1 */\\n  letter-spacing: inherit; /* 1 */\\n  color: inherit; /* 1 */\\n  margin: 0; /* 2 */\\n  padding: 0; /* 3 */\\n}\\n\\n/*\\nRemove the inheritance of text transform in Edge and Firefox.\\n*/\\n\\nbutton,\\nselect {\\n  text-transform: none;\\n}\\n\\n/*\\n1. Correct the inability to style clickable types in iOS and Safari.\\n2. Remove default button styles.\\n*/\\n\\nbutton,\\ninput:where([type='button']),\\ninput:where([type='reset']),\\ninput:where([type='submit']) {\\n  -webkit-appearance: button; /* 1 */\\n  background-color: transparent; /* 2 */\\n  background-image: none; /* 2 */\\n}\\n\\n/*\\nUse the modern Firefox focus style for all focusable elements.\\n*/\\n\\n:-moz-focusring {\\n  outline: auto;\\n}\\n\\n/*\\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\\n*/\\n\\n:-moz-ui-invalid {\\n  box-shadow: none;\\n}\\n\\n/*\\nAdd the correct vertical alignment in Chrome and Firefox.\\n*/\\n\\nprogress {\\n  vertical-align: baseline;\\n}\\n\\n/*\\nCorrect the cursor style of increment and decrement buttons in Safari.\\n*/\\n\\n::-webkit-inner-spin-button,\\n::-webkit-outer-spin-button {\\n  height: auto;\\n}\\n\\n/*\\n1. Correct the odd appearance in Chrome and Safari.\\n2. Correct the outline style in Safari.\\n*/\\n\\n[type='search'] {\\n  -webkit-appearance: textfield; /* 1 */\\n  outline-offset: -2px; /* 2 */\\n}\\n\\n/*\\nRemove the inner padding in Chrome and Safari on macOS.\\n*/\\n\\n::-webkit-search-decoration {\\n  -webkit-appearance: none;\\n}\\n\\n/*\\n1. Correct the inability to style clickable types in iOS and Safari.\\n2. Change font properties to `inherit` in Safari.\\n*/\\n\\n::-webkit-file-upload-button {\\n  -webkit-appearance: button; /* 1 */\\n  font: inherit; /* 2 */\\n}\\n\\n/*\\nAdd the correct display in Chrome and Safari.\\n*/\\n\\nsummary {\\n  display: list-item;\\n}\\n\\n/*\\nRemoves the default spacing and border for appropriate elements.\\n*/\\n\\nblockquote,\\ndl,\\ndd,\\nh1,\\nh2,\\nh3,\\nh4,\\nh5,\\nh6,\\nhr,\\nfigure,\\np,\\npre {\\n  margin: 0;\\n}\\n\\nfieldset {\\n  margin: 0;\\n  padding: 0;\\n}\\n\\nlegend {\\n  padding: 0;\\n}\\n\\nol,\\nul,\\nmenu {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n/*\\nReset default styling for dialogs.\\n*/\\ndialog {\\n  padding: 0;\\n}\\n\\n/*\\nPrevent resizing textareas horizontally by default.\\n*/\\n\\ntextarea {\\n  resize: vertical;\\n}\\n\\n/*\\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\\n2. Set the default placeholder color to the user's configured gray 400 color.\\n*/\\n\\ninput::-moz-placeholder, textarea::-moz-placeholder {\\n  opacity: 1; /* 1 */\\n  color: #9ca3af; /* 2 */\\n}\\n\\ninput::placeholder,\\ntextarea::placeholder {\\n  opacity: 1; /* 1 */\\n  color: #9ca3af; /* 2 */\\n}\\n\\n/*\\nSet the default cursor for buttons.\\n*/\\n\\nbutton,\\n[role=\\\"button\\\"] {\\n  cursor: pointer;\\n}\\n\\n/*\\nMake sure disabled buttons don't get the pointer cursor.\\n*/\\n:disabled {\\n  cursor: default;\\n}\\n\\n/*\\n1. Make replaced elements `display: block` by default. (https://github.com/mozdevs/cssremedy/issues/14)\\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\\n   This can trigger a poorly considered lint error in some tools but is included by design.\\n*/\\n\\nimg,\\nsvg,\\nvideo,\\ncanvas,\\naudio,\\niframe,\\nembed,\\nobject {\\n  display: block; /* 1 */\\n  vertical-align: middle; /* 2 */\\n}\\n\\n/*\\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\\n*/\\n\\nimg,\\nvideo {\\n  max-width: 100%;\\n  height: auto;\\n}\\n\\n/* Make elements with the HTML hidden attribute stay hidden by default */\\n[hidden]:where(:not([hidden=\\\"until-found\\\"])) {\\n  display: none;\\n}\\n  :root {\\n    /* ━━ DARK PALETTE (source) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */\\n\\n    /* Surfaces */\\n    --dark-background: 20 13% 3%;\\n    /* #090807 */\\n    --dark-foreground: 0 0% 100%;\\n    /* white chat text */\\n    --dark-card: 20 10% 6%;\\n    /* lifted dark glass */\\n    --dark-card-foreground: 0 0% 100%;\\n    --dark-popover: 20 10% 6%;\\n    --dark-popover-foreground: 0 0% 100%;\\n    --dark-muted: 20 10% 8%;\\n    --dark-muted-foreground: 0 0% 85%;\\n\\n    /* Brand — bronze */\\n    --dark-primary: 22 25% 51%;\\n    /* #A17A63 */\\n    --dark-primary-foreground: 0 0% 100%;\\n    --dark-primary-muted: 22 20% 65%;\\n    --dark-primary-hover: 22 26% 43%;\\n    /* #8A6651 */\\n    --dark-primary-subtle: 22 26% 62%;\\n    /* #B89382 */\\n    --dark-primary-light: 21 31% 58%;\\n    /* #B58A73 */\\n    --dark-primary-bright: 31 59% 78%;\\n    /* #E8C8A6 */\\n    --dark-primary-container: 343 14% 80%;\\n    /* #D6C1C7 */\\n\\n    /* Secondary — warm rose */\\n    --dark-secondary: 343 14% 80%;\\n    /* #D6C1C7 */\\n    --dark-secondary-foreground: 20 13% 3%;\\n    --dark-secondary-container: 347 24% 88%;\\n    /* #E9DADD */\\n\\n    /* Accent */\\n    --dark-accent: 22 25% 51%;\\n    --dark-accent-foreground: 0 0% 100%;\\n    --dark-accent-gold: 36 52% 53%;\\n    /* #C6944A */\\n    --dark-accent-sage: 106 12% 66%;\\n    /* #A2B29D */\\n\\n    /* Status */\\n    --dark-destructive: 0 74% 52%;\\n    --dark-destructive-foreground: 0 0% 100%;\\n    --dark-destructive-subtle: 0 74% 70%;\\n    --dark-warning: 38 92% 55%;\\n    --dark-warning-foreground: 0 0% 100%;\\n    --dark-warning-subtle: 38 92% 72%;\\n    --dark-success: 142 71% 45%;\\n    --dark-success-foreground: 0 0% 100%;\\n    --dark-success-subtle: 142 71% 68%;\\n    --dark-info: 217 91% 60%;\\n    --dark-info-foreground: 0 0% 100%;\\n    --dark-info-subtle: 217 91% 72%;\\n\\n    /* Tag palette — category badges in notes/chat */\\n    --dark-tag-venue: 217 91% 60%;\\n    --dark-tag-venue-fg: 217 91% 78%;\\n    --dark-tag-catering: 27 96% 61%;\\n    --dark-tag-catering-fg: 27 96% 76%;\\n    --dark-tag-ceremony: 48 96% 53%;\\n    --dark-tag-ceremony-fg: 48 96% 72%;\\n    --dark-tag-reception: 0 84% 60%;\\n    --dark-tag-reception-fg: 0 84% 76%;\\n    --dark-tag-honeymoon: 189 94% 43%;\\n    --dark-tag-honeymoon-fg: 189 94% 65%;\\n    --dark-tag-guest: 142 71% 45%;\\n    --dark-tag-guest-fg: 142 71% 68%;\\n    --dark-tag-vendor: 239 84% 67%;\\n    --dark-tag-vendor-fg: 239 84% 80%;\\n    --dark-tag-music: 239 84% 67%;\\n    --dark-tag-music-fg: 239 84% 80%;\\n    --dark-tag-flowers: 330 81% 60%;\\n    --dark-tag-flowers-fg: 330 81% 76%;\\n\\n    /* Form chrome */\\n    --dark-border: 21 44% 26%;\\n    /* #603B25 */\\n    --dark-input: 20 10% 10%;\\n    --dark-ring: 22 25% 51%;\\n\\n    /* Sidebar — glass bronze panel */\\n    --dark-sidebar-background: 23 60% 55%;\\n    /* #D07A46 */\\n    --dark-sidebar-foreground: 0 0% 100%;\\n    --dark-sidebar-primary: 22 25% 51%;\\n    --dark-sidebar-primary-foreground: 0 0% 100%;\\n    --dark-sidebar-accent: 22 25% 51%;\\n    --dark-sidebar-accent-foreground: 0 0% 100%;\\n    --dark-sidebar-border: 21 44% 26%;\\n    --dark-sidebar-ring: 22 25% 51%;\\n\\n    /* Surface elevation */\\n    --dark-surface: 20 13% 3%;\\n    --dark-surface-container: 20 10% 5%;\\n    --dark-surface-container-low: 20 12% 4%;\\n    --dark-surface-container-high: 20 10% 7%;\\n    --dark-surface-container-highest: 20 10% 10%;\\n    --dark-card-elevated: 20 11% 5%;\\n    --dark-outline: 21 44% 26%;\\n    --dark-outline-variant: 20 10% 14%;\\n\\n    /* Unique surfaces */\\n    --dark-surface-note: 337 44% 7%;\\n    /* #1A0A10 */\\n    --dark-surface-popover-alt: 0 0% 10%;\\n    --dark-surface-tooltip: 346 36% 12%;\\n    --dark-surface-toast: 336 61% 14%;\\n\\n    /* Figma raw RGB values */\\n    --dark-bronze: 161 122 99;\\n    /* #A17A63 */\\n    --dark-rose: 255 255 255;\\n    --dark-header-pink: 214 193 199;\\n    --dark-sidebar-fill: 208 122 70;\\n    /* #D07A46 */\\n    --dark-sidebar-stroke: 96 59 37;\\n    /* #603B25 */\\n    --dark-grid-bg: 42 42 42;\\n    /* #2A2A2A — grid stroke */\\n    --dark-glow-outer: 10 10 10;\\n\\n    /* Mode button active backgrounds */\\n    --dark-mode-auto-active: 30 10% 49%;\\n    /* #8A7E72 */\\n    --dark-mode-stylist-active: 46 65% 52%;\\n    /* #D4AF37 */\\n    --dark-mode-knowledge-active: 29 13% 37%;\\n    /* #6B5E52 */\\n\\n    /* Category palette */\\n    --dark-cat-budget: 38 92% 50%;\\n    --dark-cat-budget-fg: 38 92% 70%;\\n    --dark-cat-budget-deep: 32 95% 44%;\\n    --dark-cat-budget-darker: 26 90% 37%;\\n    --dark-cat-timeline: 330 81% 60%;\\n    --dark-cat-timeline-fg: 330 81% 75%;\\n    --dark-cat-timeline-soft: 326 78% 95%;\\n    --dark-cat-timeline-deep: 335 78% 42%;\\n    --dark-cat-milestone: 271 91% 65%;\\n    --dark-cat-milestone-fg: 271 91% 78%;\\n    --dark-cat-planner: 23 60% 55%;\\n    --dark-cat-planner-fg: 23 75% 72%;\\n    --dark-cat-stylist: 343 14% 80%;\\n    --dark-cat-knowledge: 21 44% 26%;\\n    --dark-cat-auto: 22 25% 51%;\\n\\n    /* Overlays — lightbox/toolbar scrims (same in both themes, see rationale in .light) */\\n    --dark-overlay-scrim: 0 0% 0%;\\n    /* pure black backdrop */\\n    --dark-overlay-surface: 0 0% 100%;\\n    /* white-tint fill for buttons on scrim */\\n    --dark-overlay-border: 0 0% 100%;\\n    --dark-overlay-text: 0 0% 100%;\\n\\n    /* Glass surfaces — theme-aware card/chip backgrounds (full rgba values) */\\n    --dark-glass-bg: rgb(255 255 255 / 0.04);\\n    --dark-glass-bg-hover: rgb(255 255 255 / 0.07);\\n    --dark-glass-border: rgb(255 255 255 / 0.10);\\n    --dark-glass-border-hover: rgb(161 122 99 / 0.40);\\n\\n    /* Gradient-bg layer: grid alpha + radial bloom (theme-aware) */\\n    --dark-grid-alpha: 0.35;\\n    --dark-grad-bg-bloom:\\n      radial-gradient(ellipse 55% 80% at 95% 0%, rgb(208 123 70) 0%, rgb(var(--dark-sidebar-fill) / 0.22) 30%, rgb(10 10 10 / 0) 70%),\\n      radial-gradient(ellipse 75% 70% at 5% 100%, rgb(208 123 70) 0%, rgb(var(--dark-sidebar-fill) / 0.22) 30%, rgb(10 10 10 / 0) 70%);\\n\\n    /* Elevation shadows */\\n    --dark-shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.08);\\n    --dark-shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.18);\\n    --dark-shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.25);\\n    --dark-shadow-modal: 0 32px 64px -12px rgb(0 0 0 / 0.7), 0 0 0 1px rgb(255 255 255 / 0.05);\\n    --dark-shadow-dropdown: 0 16px 48px -12px rgb(0 0 0 / 0.7);\\n    --dark-shadow-dropdown-sm: 0 25px 50px -12px rgb(0 0 0 / 0.4);\\n    --dark-shadow-glass: 0 8px 32px rgb(0 0 0 / 0.37);\\n    --dark-shadow-glow-brand: 0 0 24px rgb(161 122 99 / 0.12);\\n    --dark-shadow-input-focus: 0 0 0 1px rgb(161 122 99 / 0.4), 0 0 24px rgb(161 122 99 / 0.12);\\n    --dark-shadow-card-hover: 0 8px 32px rgb(161 122 99 / 0.12);\\n    --dark-shadow-card: inset 0 1px 0 rgb(255 255 255 / 0.08), inset 0 -1px 0 rgb(255 255 255 / 0.03), 0 16px 48px -12px rgb(0 0 0 / 0.55);\\n\\n    /* Gradients */\\n    --dark-grad-brand-bloom:\\n      radial-gradient(ellipse 55% 80% at 95% 0%, rgb(208 123 70) 0%, rgb(208 122 70 / 0.22) 30%, rgb(10 10 10 / 0) 70%),\\n      radial-gradient(ellipse 75% 70% at 5% 100%, rgb(208 123 70) 0%, rgb(208 122 70 / 0.22) 30%, rgb(10 10 10 / 0) 70%);\\n    --dark-grad-sidebar: linear-gradient(180deg, rgb(208 122 70 / 0.03) 0%, rgb(208 122 70 / 0.02) 100%);\\n    --dark-grad-sidebar-chip: linear-gradient(180deg, rgb(161 122 99 / 0.35) 0%, rgb(161 122 99 / 0.22) 100%);\\n\\n\\n    /* ━━ LIGHT PALETTE (source) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n       Warm-ivory / terracotta / gold system derived from lightmode.html.\\n       No --dark-* tokens referenced below — fully independent. */\\n\\n    /* Surfaces */\\n    --light-background: white;\\n    /* #FAF6F0 warm ivory */\\n    --light-foreground: 21 41% 16%;\\n    /* #3A2418 deep coffee */\\n    --light-card: 0 0% 100%;\\n    --light-card-foreground: 21 41% 16%;\\n    --light-popover: 0 0% 100%;\\n    --light-popover-foreground: 21 41% 16%;\\n    --light-muted: 33 53% 92%;\\n    /* #F5EDE1 */\\n    --light-muted-foreground: 22 20% 45%;\\n    /* #8B6F5C */\\n\\n    /* Brand */\\n    --light-primary: 22 25% 51%;\\n    --light-primary-foreground: 0 0% 100%;\\n    --light-primary-muted: 22 20% 58%;\\n    --light-primary-hover: 22 26% 43%;\\n    --light-primary-subtle: 22 26% 62%;\\n    --light-primary-light: 21 31% 58%;\\n    --light-primary-bright: 31 59% 78%;\\n    --light-primary-container: 343 14% 80%;\\n\\n    /* Secondary */\\n    --light-secondary: 347 30% 88%;\\n    --light-secondary-foreground: 21 41% 16%;\\n    --light-secondary-container: 347 24% 88%;\\n\\n    /* Accent */\\n    --light-accent: 22 25% 51%;\\n    --light-accent-foreground: 0 0% 100%;\\n    --light-accent-gold: 36 48% 60%;\\n    --light-accent-sage: 106 12% 50%;\\n\\n    /* Status */\\n    --light-destructive: 0 74% 48%;\\n    --light-destructive-foreground: 0 0% 100%;\\n    --light-destructive-subtle: 0 74% 42%;\\n    --light-warning: 38 92% 48%;\\n    --light-warning-foreground: 21 41% 16%;\\n    --light-warning-subtle: 32 95% 42%;\\n    --light-success: 142 71% 32%;\\n    --light-success-foreground: 0 0% 100%;\\n    --light-success-subtle: 142 71% 28%;\\n    --light-info: 217 91% 48%;\\n    --light-info-foreground: 0 0% 100%;\\n    --light-info-subtle: 217 91% 40%;\\n\\n    /* Tag palette — deeper for readability on ivory */\\n    --light-tag-venue: 217 91% 48%;\\n    --light-tag-venue-fg: 217 91% 35%;\\n    --light-tag-catering: 27 96% 48%;\\n    --light-tag-catering-fg: 27 96% 35%;\\n    --light-tag-ceremony: 48 85% 42%;\\n    --light-tag-ceremony-fg: 42 85% 32%;\\n    --light-tag-reception: 0 74% 48%;\\n    --light-tag-reception-fg: 0 74% 38%;\\n    --light-tag-honeymoon: 189 94% 38%;\\n    --light-tag-honeymoon-fg: 189 94% 28%;\\n    --light-tag-guest: 142 71% 32%;\\n    --light-tag-guest-fg: 142 71% 26%;\\n    --light-tag-vendor: 239 70% 55%;\\n    --light-tag-vendor-fg: 239 70% 42%;\\n    --light-tag-music: 239 70% 55%;\\n    --light-tag-music-fg: 239 70% 42%;\\n    --light-tag-flowers: 330 75% 48%;\\n    --light-tag-flowers-fg: 330 75% 38%;\\n\\n    /* Form chrome */\\n    --light-border: 33 44% 85%;\\n    /* #E8DCC8 warm beige */\\n    --light-input: 0 0% 100%;\\n    --light-ring: 22 25% 51%;\\n\\n    /* Sidebar — light ivory glass */\\n    --light-sidebar-background: 35 60% 94%;\\n    /* #F8F2E8 */\\n    --light-sidebar-foreground: 21 41% 16%;\\n    --light-sidebar-primary: 22 25% 51%;\\n    --light-sidebar-primary-foreground: 0 0% 100%;\\n    --light-sidebar-accent: 22 25% 51%;\\n    --light-sidebar-accent-foreground: 0 0% 100%;\\n    --light-sidebar-border: 33 44% 85%;\\n    --light-sidebar-ring: 22 25% 51%;\\n\\n    /* Surface elevation */\\n    --light-surface: 37 49% 96%;\\n    --light-surface-container: 40 100% 97%;\\n    /* #FFF9F0 */\\n    --light-surface-container-low: 33 53% 92%;\\n    --light-surface-container-high: 0 0% 100%;\\n    --light-surface-container-highest: 0 0% 100%;\\n    --light-card-elevated: 0 0% 100%;\\n    --light-outline: 33 44% 85%;\\n    --light-outline-variant: 33 44% 90%;\\n\\n    /* Unique surfaces */\\n    --light-surface-note: 40 100% 97%;\\n    --light-surface-popover-alt: 0 0% 100%;\\n    --light-surface-tooltip: 21 41% 16%;\\n    /* inverse: dark chip in light UI */\\n    --light-surface-toast: 21 41% 16%;\\n\\n    /* Figma raw RGB values */\\n    --light-bronze: 161 122 99;\\n    --light-rose: 250 246 240;\\n    --light-header-pink: 214 193 199;\\n    --light-sidebar-fill: 208 122 70;\\n    --light-sidebar-stroke: 96 59 37;\\n    --light-grid-bg: 138 95 70;\\n    /* warm brown grid on ivory */\\n    --light-glow-outer: 250 246 240;\\n\\n    /* Mode button active backgrounds */\\n    --light-mode-auto-active: 22 25% 51%;\\n    --light-mode-stylist-active: 46 65% 45%;\\n    --light-mode-knowledge-active: 29 13% 37%;\\n\\n    /* Category palette — deeper variants for readability on cream */\\n    --light-cat-budget: 38 92% 50%;\\n    --light-cat-budget-fg: 32 95% 44%;\\n    --light-cat-budget-deep: 32 95% 44%;\\n    --light-cat-budget-darker: 26 90% 37%;\\n    --light-cat-timeline: 330 81% 60%;\\n    --light-cat-timeline-fg: 335 78% 42%;\\n    --light-cat-timeline-soft: 326 78% 95%;\\n    --light-cat-timeline-deep: 335 78% 42%;\\n    --light-cat-milestone: 271 91% 58%;\\n    --light-cat-milestone-fg: 271 91% 50%;\\n    --light-cat-planner: 23 60% 50%;\\n    --light-cat-planner-fg: 23 75% 42%;\\n    --light-cat-stylist: 343 35% 65%;\\n    --light-cat-knowledge: 21 44% 26%;\\n    --light-cat-auto: 22 25% 51%;\\n\\n    /* Overlays — lightbox/toolbar retain the cinema dark scrim in light mode.\\n       Kept in the light source palette for parity; values intentionally match. */\\n    --light-overlay-scrim: 0 0% 0%;\\n    --light-overlay-surface: 0 0% 100%;\\n    --light-overlay-border: 0 0% 100%;\\n    --light-overlay-text: 0 0% 100%;\\n\\n    /* Glass surfaces — solid card on ivory; retains warm-brown border accent */\\n    --light-glass-bg: rgb(248 248 248 / 75%);\\n    --light-glass-bg-hover: rgb(255 255 255 / 0.95);\\n    --light-glass-border: rgb(138 95 70 / 0.18);\\n    --light-glass-border-hover: rgb(161 122 99 / 0.45);\\n\\n    /* Gradient-bg layer — softer grid + warm ivory fade-out bloom */\\n    --light-grid-alpha: 0.05;\\n    --light-grad-bg-bloom:\\n      radial-gradient(ellipse 55% 80% at 95% 0%, rgb(208 123 70 / 28%) 0%, rgb(208 122 70 / 0.12) 30%, rgb(250 246 240 / 0) 70%),\\n      radial-gradient(ellipse 75% 70% at 5% 100%, rgb(208 123 70 / 63%) 0%, rgb(208 122 70 / 11%) 30%, rgb(250 246 240 / 0%) 70%);\\n\\n    /* Shadows — soft warm-brown alpha (per lightmode.html) */\\n    --light-shadow-sm: 0 2px 8px rgb(138 95 70 / 0.06);\\n    --light-shadow-md: 0 4px 16px rgb(138 95 70 / 0.08);\\n    --light-shadow-lg: 0 10px 30px rgb(138 95 70 / 0.10);\\n    --light-shadow-modal: 0 32px 64px -12px rgb(138 95 70 / 0.25), 0 0 0 1px rgb(138 95 70 / 0.08);\\n    --light-shadow-dropdown: 0 16px 48px -12px rgb(138 95 70 / 0.18);\\n    --light-shadow-dropdown-sm: 0 25px 50px -12px rgb(138 95 70 / 0.15);\\n    --light-shadow-glass: 0 8px 32px rgb(138 95 70 / 0.08);\\n    --light-shadow-glow-brand: 0 0 24px rgb(161 122 99 / 0.25);\\n    --light-shadow-input-focus: 0 0 0 1px rgb(161 122 99 / 0.5), 0 0 24px rgb(161 122 99 / 0.15);\\n    --light-shadow-card-hover: 0 8px 32px rgb(161 122 99 / 0.12);\\n    --light-shadow-card: 0 4px 16px rgb(138 95 70 / 0.08);\\n\\n    /* Gradients — lighter end stops */\\n    --light-grad-brand-bloom:\\n      radial-gradient(ellipse 55% 80% at 95% 0%, rgb(208 123 70 / 0.35) 0%, rgb(208 122 70 / 0.10) 30%, rgb(250 246 240 / 0) 70%),\\n      radial-gradient(ellipse 75% 70% at 5% 100%, rgb(208 123 70 / 0.35) 0%, rgb(208 122 70 / 0.10) 30%, rgb(250 246 240 / 0) 70%);\\n    --light-grad-sidebar: linear-gradient(180deg, rgb(255 255 255 / 0.5) 0%, rgb(255 255 255 / 0.3) 100%);\\n    --light-grad-sidebar-chip: linear-gradient(180deg, rgb(161 122 99 / 0.15) 0%, rgb(161 122 99 / 0.08) 100%);\\n\\n\\n    /* ━━ SEMANTIC ALIASES (public API, default → dark) ━━━━━━━━━━━━━━━━━━━\\n       Components and Tailwind consume these shared names. `.dark` / `.light`\\n       below re-bind them to the corresponding source block. Default (no\\n       class on <html>) falls back to dark — matches prior behaviour. */\\n\\n    --radius: 1rem;\\n\\n    --background: var(--dark-background);\\n    --foreground: var(--dark-foreground);\\n    --card: var(--dark-card);\\n    --card-foreground: var(--dark-card-foreground);\\n    --popover: var(--dark-popover);\\n    --popover-foreground: var(--dark-popover-foreground);\\n    --muted: var(--dark-muted);\\n    --muted-foreground: var(--dark-muted-foreground);\\n\\n    --primary: var(--dark-primary);\\n    --primary-foreground: var(--dark-primary-foreground);\\n    --primary-muted: var(--dark-primary-muted);\\n    --primary-hover: var(--dark-primary-hover);\\n    --primary-subtle: var(--dark-primary-subtle);\\n    --primary-light: var(--dark-primary-light);\\n    --primary-bright: var(--dark-primary-bright);\\n    --primary-container: var(--dark-primary-container);\\n\\n    --secondary: var(--dark-secondary);\\n    --secondary-foreground: var(--dark-secondary-foreground);\\n    --secondary-container: var(--dark-secondary-container);\\n\\n    --accent: var(--dark-accent);\\n    --accent-foreground: var(--dark-accent-foreground);\\n    --accent-gold: var(--dark-accent-gold);\\n    --accent-sage: var(--dark-accent-sage);\\n\\n    --destructive: var(--dark-destructive);\\n    --destructive-foreground: var(--dark-destructive-foreground);\\n    --destructive-subtle: var(--dark-destructive-subtle);\\n    --warning: var(--dark-warning);\\n    --warning-foreground: var(--dark-warning-foreground);\\n    --warning-subtle: var(--dark-warning-subtle);\\n    --success: var(--dark-success);\\n    --success-foreground: var(--dark-success-foreground);\\n    --success-subtle: var(--dark-success-subtle);\\n    --info: var(--dark-info);\\n    --info-foreground: var(--dark-info-foreground);\\n    --info-subtle: var(--dark-info-subtle);\\n\\n    --tag-venue: var(--dark-tag-venue);\\n    --tag-venue-fg: var(--dark-tag-venue-fg);\\n    --tag-catering: var(--dark-tag-catering);\\n    --tag-catering-fg: var(--dark-tag-catering-fg);\\n    --tag-ceremony: var(--dark-tag-ceremony);\\n    --tag-ceremony-fg: var(--dark-tag-ceremony-fg);\\n    --tag-reception: var(--dark-tag-reception);\\n    --tag-reception-fg: var(--dark-tag-reception-fg);\\n    --tag-honeymoon: var(--dark-tag-honeymoon);\\n    --tag-honeymoon-fg: var(--dark-tag-honeymoon-fg);\\n    --tag-guest: var(--dark-tag-guest);\\n    --tag-guest-fg: var(--dark-tag-guest-fg);\\n    --tag-vendor: var(--dark-tag-vendor);\\n    --tag-vendor-fg: var(--dark-tag-vendor-fg);\\n    --tag-music: var(--dark-tag-music);\\n    --tag-music-fg: var(--dark-tag-music-fg);\\n    --tag-flowers: var(--dark-tag-flowers);\\n    --tag-flowers-fg: var(--dark-tag-flowers-fg);\\n\\n    --border: var(--dark-border);\\n    --input: var(--dark-input);\\n    --ring: var(--dark-ring);\\n\\n    --sidebar-background: va