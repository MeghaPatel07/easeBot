eaders,\n      body: body === void 0 ? void 0 : JSON.stringify(body)\n    });\n  } catch (e) {\n    throw makeError(0, \"network\", e.message || \"Network error\");\n  }\n  if (res.status === 401) throw makeError(401, \"unauthenticated\", \"Not signed in\");\n  if (res.status === 501) throw makeError(501, \"not_implemented\", \"Backend not yet available\");\n  if (res.status === 402) {\n    const payload = await res.json().catch(() => null);\n    if (payload && typeof window !== \"undefined\") {\n      window.dispatchEvent(new CustomEvent(QUOTA_EVENT, { detail: payload }));\n    }\n    const err = makeError(402, \"quota_exceeded\", payload?.message ?? \"Quota exceeded\");\n    err.details = payload;\n    throw err;\n  }\n  if (!res.ok) {\n    const text = await res.text().catch(() => \"\");\n    throw makeError(res.status, \"server\", text || `Request failed (${res.status})`);\n  }\n  if (res.status === 204) return void 0;\n  return res.json();\n}\nasync function requestBlob(path) {\n  const token = await getAuthToken();\n  if (!token) throw makeError(401, \"unauthenticated\", \"Not signed in\");\n  let res;\n  try {\n    res = await fetch(`${API_BASE}${path}`, {\n      method: \"GET\",\n      headers: { Authorization: `Bearer ${token}` }\n    });\n  } catch (e) {\n    throw makeError(0, \"network\", e.message || \"Network error\");\n  }\n  if (res.status === 401) throw makeError(401, \"unauthenticated\", \"Not signed in\");\n  if (!res.ok) {\n    const text = await res.text().catch(() => \"\");\n    throw makeError(res.status, \"server\", text || `Request failed (${res.status})`);\n  }\n  return res.blob();\n}\nexport async function getAccountMe() {\n  const res = await request(\"GET\", \"/api/account/me\");\n  if (res && res.plan && res.plan.tier === \"premium\") {\n    console.warn('[accountService] backend returned legacy tier=\"premium\"; normalizing to \"promax\"');\n    res.plan.tier = \"promax\";\n  }\n  return res;\n}\nexport function patchAccountProfile(patch) {\n  return request(\"PATCH\", \"/api/account/profile\", patch);\n}\nexport function patchAccountPreferences(patch) {\n  return request(\"PATCH\", \"/api/account/preferences\", patch);\n}\nexport function getAccountPlan() {\n  return request(\"GET\", \"/api/account/plan\");\n}\nexport function getAccountUsage() {\n  return request(\"GET\", \"/api/account/usage\");\n}\nexport function getTokenPoolUsage() {\n  return request(\"GET\", \"/api/account/usage\");\n}\nexport function switchPlan(tier) {\n  return request(\"POST\", \"/api/account/plan/switch\", { tier });\n}\nexport function exportAccountData() {\n  return requestBlob(\"/api/account/export\");\n}\nexport function clearChatHistory() {\n  return request(\"DELETE\", \"/api/account/history\");\n}\nexport function deleteAccount() {\n  return request(\"POST\", \"/api/account/delete\");\n}\nexport function signOutEverywhere() {\n  return request(\"POST\", \"/api/account/sign-out-everywhere\");\n}\n\n//# sourceMappingURL=data:application/json;base64,"
