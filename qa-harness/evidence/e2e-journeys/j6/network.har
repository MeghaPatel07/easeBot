            "text": "import { doc, updateDoc } from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nexport async function savePersonalization(uid, settings) {\n  await updateDoc(doc(db, \"users\", uid), {\n    ...settings.nickname !== void 0 && { nickname: settings.nickname },\n    ...settings.voiceId !== void 0 && { voiceId: settings.voiceId },\n    ...settings.toneSettings !== void 0 && { toneSettings: settings.toneSettings }\n  });\n}\nconst GUEST_VOICE_KEY = \"easebot:voiceId\";\nexport function getLocalVoiceId() {\n  try {\n    return localStorage.getItem(GUEST_VOICE_KEY);\n  } catch {\n    return null;\n  }\n}\nexport function setLocalVoiceId(voiceId) {\n  try {\n    if (voiceId) localStorage.setItem(GUEST_VOICE_KEY, voiceId);\n    else localStorage.removeItem(GUEST_VOICE_KEY);\n  } catch {\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
