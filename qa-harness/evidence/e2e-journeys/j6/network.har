          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "import __vite__cjsImport0_react from \"/node_modules/.vite/deps/react.js?v=17f5c807\"; const useCallback = __vite__cjsImport0_react[\"useCallback\"];\nimport { useMutation, useQuery, useQueryClient } from \"/node_modules/.vite/deps/@tanstack_react-query.js?v=17f5c807\";\nimport { useAuth } from \"/src/contexts/AuthContext.tsx\";\nimport {\n  getAccountMe,\n  patchAccountProfile,\n  patchAccountPreferences\n} from \"/src/services/accountService.ts\";\nconst ACCOUNT_QUERY_KEY = [\"account\", \"me\"];\nfunction deriveLocal(profile) {\n  if (!profile) return null;\n  const tier = profile.tierMirror ?? profile.plan ?? (profile.isPremium ? \"pro\" : \"free\");\n  const usage = {\n    messagesUsed: profile.usage?.messagesUsed ?? 0,\n    messagesAllowed: profile.usage?.messagesAllowed ?? (tier === \"free\" ? 100 : 1e4)\n  };\n  return {\n    profile,\n    plan: { tier },\n    usage\n  };\n}\nexport function useAccount() {\n  const { user, profile: authProfile } = useAuth();\n  const qc = useQueryClient();\n  const enabled = !!user;\n  const query = useQuery({\n    queryKey: ACCOUNT_QUERY_KEY,\n    queryFn: getAccountMe,\n    enabled,\n    retry: (failureCount, err) => {\n      if (err?.code === \"unauthenticated\" || err?.code === \"not_implemented\") return false;\n      return failureCount < 1;\n    },\n    staleTime: 3e4\n  });\n  const profileMutation = useMutation({\n    mutationFn: patchAccountProfile,\n    onSuccess: () => qc.invalidateQueries({ queryKey: ACCOUNT_QUERY_KEY })\n  });\n  const prefsMutation = useMutation({\n    mutationFn: patchAccountPreferences,\n    onSuccess: () => qc.invalidateQueries({ queryKey: ACCOUNT_QUERY_KEY })\n  });\n  const updateProfile = useCallback(\n    async (patch) => {\n      try {\n        await profileMutation.mutateAsync(patch);\n        return { ok: true };\n      } catch (err) {\n        const e = err;\n        throw e;\n      }\n    },\n    [profileMutation]\n  );\n  const updatePreferences = useCallback(\n    async (patch) => {\n      try {\n        await prefsMutation.mutateAsync(patch);\n        return { ok: true };\n      } catch (err) {\n        const e = err;\n        throw e;\n      }\n    },\n    [prefsMutation]\n  );\n  const local = deriveLocal(authProfile);\n  const data = query.data ?? local;\n  const error = query.error ?? null;\n  const isFallback = !query.data && !!local;\n  return {\n    profile: data?.profile ?? authProfile ?? null,\n    plan: data?.plan ?? null,\n    usage: data?.usage ?? null,\n    isLoading: enabled && query.isLoading && !local,\n    error,\n    isFallback,\n    isUpdatingProfile: profileMutation.isPending,\n    isUpdatingPreferences: prefsMutation.isPending,\n    updateProfile,\n    updatePreferences\n  };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
