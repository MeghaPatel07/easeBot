            "size": -1,
            "mimeType": "text/javascript",
            "text": "import {\n  collection,\n  deleteDoc,\n  doc,\n  onSnapshot,\n  query,\n  where\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction timelineEventsCol() {\n  return collection(db, \"timelineEvents\");\n}\nfunction timelineEventDoc(id) {\n  return doc(db, \"timelineEvents\", id);\n}\nfunction tsToDate(ts) {\n  return ts ? ts.toDate?.() ?? null : null;\n}\nfunction mapTimelineEvent(id, data) {\n  return {\n    id,\n    ownerId: data.ownerId ?? \"\",\n    ownerEmail: data.ownerEmail ?? null,\n    title: data.title ?? \"\",\n    date: data.date ?? \"\",\n    description: data.description ?? null,\n    category: data.category ?? null,\n    source: data.source ?? \"manual\",\n    isDeleted: data.isDeleted ?? false,\n    createdAt: tsToDate(data.createdAt),\n    updatedAt: tsToDate(data.updatedAt)\n  };\n}\nexport function subscribeToTimelineEvents(userId, callback) {\n  if (!userId) {\n    callback([]);\n    return () => {\n    };\n  }\n  const q = query(timelineEventsCol(), where(\"ownerId\", \"==\", userId));\n  return onSnapshot(\n    q,\n    (snap) => {\n      const events = snap.docs.map((d) => mapTimelineEvent(d.id, d.data())).filter((e) => !e.isDeleted);\n      callback(events);\n    },\n    (err) => {\n      console.error(\"[subscribeToTimelineEvents]\", err.message);\n      callback([]);\n    }\n  );\n}\nexport async function deleteTimelineEvent(eventId) {\n  await deleteDoc(timelineEventDoc(eventId));\n}\n\n//# sourceMappingURL=data:application/json;base64,"
