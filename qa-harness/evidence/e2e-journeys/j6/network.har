            "mimeType": "text/javascript",
            "text": "import {\n  collection,\n  doc,\n  addDoc,\n  updateDoc,\n  deleteDoc,\n  onSnapshot,\n  serverTimestamp,\n  query,\n  orderBy,\n  where,\n  getDocs,\n  writeBatch\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction notificationsCol(userId) {\n  return collection(db, \"users\", userId, \"notifications\");\n}\nfunction notificationDoc(userId, notifId) {\n  return doc(db, \"users\", userId, \"notifications\", notifId);\n}\nexport function subscribeToNotifications(userId, callback) {\n  const q = query(notificationsCol(userId), orderBy(\"createdAt\", \"desc\"));\n  return onSnapshot(\n    q,\n    (snapshot) => {\n      const notifs = snapshot.docs.map((d) => ({\n        id: d.id,\n        ...d.data()\n      }));\n      callback(notifs);\n    },\n    (err) => console.error(\"[subscribeToNotifications]\", err.message)\n  );\n}\nexport async function markAsRead(userId, notifId) {\n  await updateDoc(notificationDoc(userId, notifId), { read: true });\n}\nexport async function markAllAsRead(userId, notifs) {\n  const unread = notifs.filter((n) => !n.read);\n  if (unread.length === 0) return;\n  const batch = writeBatch(db);\n  unread.forEach((n) => {\n    batch.update(notificationDoc(userId, n.id), { read: true });\n  });\n  await batch.commit();\n}\nexport async function deleteNotification(userId, notifId) {\n  await deleteDoc(notificationDoc(userId, notifId));\n}\nexport async function createNotification(userId, notif) {\n  const docRef = await addDoc(notificationsCol(userId), {\n    ...notif,\n    read: false,\n    createdAt: serverTimestamp()\n  });\n  return docRef.id;\n}\nexport async function generateOverdueNotifications(userId, checklists) {\n  const today = (/* @__PURE__ */ new Date()).toISOString().slice(0, 10);\n  const overdueItems = [];\n  for (const cl of checklists) {\n    for (const item of cl.items) {\n      if (!item.completed && item.dueDate && item.dueDate < today) {\n        overdueItems.push({\n          itemId: item.id,\n          itemText: item.text,\n          checklistTitle: cl.title,\n          dueDate: item.dueDate\n        });\n      }\n    }\n  }\n  if (overdueItems.length === 0) return;\n  const existingQuery = query(\n    notificationsCol(userId),\n    where(\"type\", \"==\", \"overdue\"),\n    where(\"relatedType\", \"==\", \"checklist-item\")\n  );\n  const existingSnap = await getDocs(existingQuery);\n  const existingRelatedIds = new Set(\n    existingSnap.docs.map((d) => d.data().relatedId)\n  );\n  for (const item of overdueItems) {\n    if (existingRelatedIds.has(item.itemId)) continue;\n    await createNotification(userId, {\n      title: `Overdue: ${item.itemText}`,\n      body: `This task from \"${item.checklistTitle}\" was due on ${item.dueDate}.`,\n      type: \"overdue\",\n      relatedId: item.itemId,\n      relatedType: \"checklist-item\"\n    });\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
