            "text": "import {\n  collection,\n  doc,\n  onSnapshot,\n  serverTimestamp,\n  query,\n  orderBy,\n  updateDoc,\n  getDoc,\n  setDoc\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction commentsCol(noteId) {\n  return collection(db, \"notes\", noteId, \"comments\");\n}\nfunction commentDoc(noteId, commentId) {\n  return doc(db, \"notes\", noteId, \"comments\", commentId);\n}\nexport async function addComment(comment) {\n  const id = crypto.randomUUID();\n  const now = serverTimestamp();\n  const data = {\n    id,\n    noteId: comment.noteId,\n    blockId: comment.blockId,\n    anchorText: comment.anchorText,\n    authorId: comment.authorId,\n    authorName: comment.authorName,\n    authorEmail: comment.authorEmail,\n    content: comment.content,\n    parentCommentId: comment.parentCommentId,\n    resolved: comment.resolved,\n    resolvedBy: comment.resolvedBy,\n    resolvedAt: comment.resolvedAt,\n    reactions: comment.reactions,\n    createdAt: now,\n    updatedAt: now,\n    isEdited: false,\n    isDeleted: false\n  };\n  await setDoc(commentDoc(comment.noteId, id), data);\n  return id;\n}\nexport async function updateComment(noteId, commentId, content) {\n  await updateDoc(commentDoc(noteId, commentId), {\n    content,\n    isEdited: true,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function deleteComment(noteId, commentId) {\n  await updateDoc(commentDoc(noteId, commentId), {\n    isDeleted: true,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function resolveComment(noteId, commentId, resolvedBy) {\n  await updateDoc(commentDoc(noteId, commentId), {\n    resolved: true,\n    resolvedBy,\n    resolvedAt: serverTimestamp(),\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function unresolveComment(noteId, commentId) {\n  await updateDoc(commentDoc(noteId, commentId), {\n    resolved: false,\n    resolvedBy: null,\n    resolvedAt: null,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function addReaction(noteId, commentId, emoji, userId) {\n  const ref = commentDoc(noteId, commentId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const data = snap.data();\n  const reactions = { ...data.reactions };\n  const users = reactions[emoji] ?? [];\n  if (!users.includes(userId)) {\n    reactions[emoji] = [...users, userId];\n  }\n  await updateDoc(ref, {\n    reactions,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function removeReaction(noteId, commentId, emoji, userId) {\n  const ref = commentDoc(noteId, commentId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const data = snap.data();\n  const reactions = { ...data.reactions };\n  const users = reactions[emoji] ?? [];\n  reactions[emoji] = users.filter((u) => u !== userId);\n  if (reactions[emoji].length === 0) {\n    delete reactions[emoji];\n  }\n  await updateDoc(ref, {\n    reactions,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function editComment(noteId, commentId, content) {\n  await updateDoc(commentDoc(noteId, commentId), {\n    content,\n    isEdited: true,\n    updatedAt: serverTimestamp()\n  });\n}\nexport function subscribeToComments(noteId, callback) {\n  const q = query(commentsCol(noteId), orderBy(\"createdAt\", \"asc\"));\n  return onSnapshot(\n    q,\n    (snapshot) => {\n      const comments = snapshot.docs.map((d) => ({\n        ...d.data(),\n        id: d.id\n      }));\n      callback(comments);\n    },\n    (err) => console.error(\"[subscribeToComments]\", err.message)\n  );\n}\n\n//# sourceMappingURL=data:application/json;base64,"
