            "text": "import {\n  collection,\n  doc,\n  addDoc,\n  deleteDoc,\n  onSnapshot,\n  serverTimestamp,\n  query,\n  orderBy,\n  updateDoc\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction savedItemsCol(userId) {\n  return collection(db, \"users\", userId, \"savedItems\");\n}\nfunction savedItemDoc(userId, itemId) {\n  return doc(db, \"users\", userId, \"savedItems\", itemId);\n}\nexport function subscribeToSavedItems(userId, callback) {\n  const q = query(savedItemsCol(userId), orderBy(\"createdAt\", \"desc\"));\n  return onSnapshot(\n    q,\n    (snapshot) => {\n      const items = snapshot.docs.map((d) => ({\n        ...d.data(),\n        id: d.id\n      }));\n      callback(items);\n    },\n    (err) => console.error(\"[subscribeToSavedItems]\", err.message)\n  );\n}\nexport async function addSavedItem(userId, item) {\n  const docRef = await addDoc(savedItemsCol(userId), {\n    ...item,\n    createdAt: serverTimestamp()\n  });\n  return docRef.id;\n}\nexport async function updateSavedItemNote(userId, itemId, note) {\n  await updateDoc(savedItemDoc(userId, itemId), { note });\n}\nexport async function updateSavedItemCategory(userId, itemId, category) {\n  await updateDoc(savedItemDoc(userId, itemId), { category });\n}\nexport async function deleteSavedItem(userId, itemId) {\n  await deleteDoc(savedItemDoc(userId, itemId));\n}\n\n//# sourceMappingURL=data:application/json;base64,"
