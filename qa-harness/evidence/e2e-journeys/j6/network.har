            "size": -1,
            "mimeType": "text/javascript",
            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_API_BASE_URL\": \"http://localhost:3001\", \"VITE_APP_VERSION\": \"dev\", \"VITE_ENABLE_PAYMENT\": \"false\", \"VITE_EXCHANGE_RATE_API_KEY\": \"ce1384b9a93b5aad0e758d61\", \"VITE_FIREBASE_API_KEY\": \"AIzaSyD3f6VSZooeyqt_8PXJveislOH7Mrn6X94\", \"VITE_FIREBASE_APP_ID\": \"1:938953154391:web:a0d08bac565b9cbc046812\", \"VITE_FIREBASE_AUTH_DOMAIN\": \"wedding-ease-dc99a.firebaseapp.com\", \"VITE_FIREBASE_MESSAGING_SENDER_ID\": \"938953154391\", \"VITE_FIREBASE_PROJECT_ID\": \"wedding-ease-dc99a\", \"VITE_FIREBASE_STORAGE_BUCKET\": \"wedding-ease-dc99a.appspot.com\", \"VITE_IP_GEOLOCATION_API_KEY\": \"f92eea25a17246a09563543976ca23d7\", \"VITE_POSTHOG_ENABLED\": \"true\", \"VITE_POSTHOG_HOST\": \"/ingest\", \"VITE_POSTHOG_KEY\": \"phc_C3dxDiWMwVzdTWbXbDXvp98L9XCm2qFTJtcgxenkkBXV\"};import {\n  doc,\n  updateDoc,\n  getDoc,\n  query,\n  where,\n  getDocs,\n  collection,\n  serverTimestamp,\n  arrayRemove\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db, auth } from \"/src/lib/firebase.ts\";\nconst API_BASE = import.meta.env.VITE_API_BASE_URL ?? \"https://backend.theweddingbot.ai\";\nasync function authedFetch(path, init) {\n  const token = await auth.currentUser?.getIdToken();\n  const headers = {\n    \"Content-Type\": \"application/json\",\n    ...init.headers\n  };\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  return fetch(`${API_BASE}${path}`, { ...init, headers });\n}\nfunction noteDoc(noteId) {\n  return doc(db, \"notes\", noteId);\n}\nfunction notesCol() {\n  return collection(db, \"notes\");\n}\nexport async function addCollaborator(noteId, collaborator) {\n  const res = await authedFetch(`/api/notes/${noteId}/share`, {\n    method: \"POST\",\n    body: JSON.stringify({\n      userId: collaborator.userId || collaborator.email,\n      email: collaborator.email,\n      name: collaborator.name,\n      permission: collaborator.permission\n    })\n  });\n  if (!res.ok) {\n    const err = await res.json().catch(() => ({}));\n    throw new Error(err.error || `Failed to add collaborator (${res.status})`);\n  }\n}\nexport async function sendNoteInvites(noteId, emails) {\n  const res = await authedFetch(`/api/notes/${noteId}/share/notify`, {\n    method: \"POST\",\n    body: JSON.stringify({ emails })\n  });\n  if (!res.ok) {\n    const err = await res.json().catch(() => ({}));\n    throw new Error(err.error || `Failed to send invites (${res.status})`);\n  }\n  return res.json();\n}\nexport async function removeCollaborator(noteId, userId) {\n  const ref = noteDoc(noteId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const note = snap.data();\n  const existing = note.collaborators ?? [];\n  const toRemove = existing.find((c) => c.userId === userId);\n  if (!toRemove) return;\n  const updated = existing.filter((c) => c.userId !== userId);\n  await updateDoc(ref, {\n    collaborators: updated,\n    collaboratorEmails: arrayRemove(toRemove.email),\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function updateCollaboratorPermission(noteId, userId, permission) {\n  const ref = noteDoc(noteId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const note = snap.data();\n  const updated = (note.collaborators ?? []).map(\n    (c) => c.userId === userId ? { ...c, permission } : c\n  );\n  await updateDoc(ref, {\n    collaborators: updated,\n    updatedAt: serverTimestamp()\n  });\n}\nexport async function enablePublicLink(noteId, permission) {\n  const shareId = crypto.randomUUID();\n  await updateDoc(noteDoc(noteId), {\n    publicAccess: {\n      enabled: true,\n      permission,\n      shareId,\n      password: null,\n      expiresAt: null,\n      createdAt: serverTimestamp()\n    },\n    publicShareId: shareId,\n    updatedAt: serverTimestamp()\n  });\n  return shareId;\n}\nexport async functio