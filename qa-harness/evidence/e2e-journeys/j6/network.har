            "text": "import {\n  collection,\n  doc,\n  getDoc,\n  setDoc,\n  updateDoc,\n  deleteDoc,\n  onSnapshot,\n  serverTimestamp\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction checklistsCol(userId) {\n  return collection(db, \"users\", userId, \"checklists\");\n}\nfunction checklistDoc(userId, checklistId) {\n  return doc(db, \"users\", userId, \"checklists\", checklistId);\n}\nexport async function createChecklist(userId, title, itemTexts) {\n  const id = crypto.randomUUID();\n  const now = serverTimestamp();\n  const items = itemTexts.map((text) => ({\n    id: crypto.randomUUID(),\n    text,\n    completed: false,\n    vendorRef: null,\n    dueDate: null\n  }));\n  const checklist = { id, userId, title, items, createdAt: now, updatedAt: now };\n  await setDoc(checklistDoc(userId, id), checklist);\n  return checklist;\n}\nexport async function duplicateChecklist(userId, source) {\n  const title = `${source.title} (Copy)`;\n  const itemTexts = source.items.map((i) => i.text);\n  await createChecklist(userId, title, itemTexts);\n}\nexport async function updateChecklistItem(userId, checklistId, itemId, newText) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.map(\n    (item) => item.id === itemId ? { ...item, text: newText } : item\n  );\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function toggleItemDone(userId, checklistId, itemId) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.map(\n    (item) => item.id === itemId ? { ...item, completed: !item.completed } : item\n  );\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function addChecklistItem(userId, checklistId, text) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items;\n  items.push({ id: crypto.randomUUID(), text, completed: false, vendorRef: null, dueDate: null });\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function deleteChecklistItem(userId, checklistId, itemId) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.filter((i) => i.id !== itemId);\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function updateItemDueDate(userId, checklistId, itemId, dueDate) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.map(\n    (item) => item.id === itemId ? { ...item, dueDate } : item\n  );\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function reorderChecklistItems(userId, checklistId, orderedItemIds) {\n  const ref = checklistDoc(userId, checklistId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const currentItems = snap.data().items;\n  const itemMap = new Map(currentItems.map((i) => [i.id, i]));\n  const reordered = orderedItemIds.map((id) => itemMap.get(id)).filter((i) => !!i);\n  for (const item of currentItems) {\n    if (!orderedItemIds.includes(item.id)) reordered.push(item);\n  }\n  await updateDoc(ref, { items: reordered, updatedAt: serverTimestamp() });\n}\nexport async function deleteChecklist(userId, checklistId) {\n  await deleteDoc(checklistDoc(userId, checklistId));\n}\nexport function subscribeToChecklists(userId, callback) {\n  return onSnapshot(\n    checklistsCol(userId),\n    (snapshot) => {\n      const checklists = snapshot.docs.map((d) => ({ ...d.data() })).sort((a, b) => {\n        const aMs = a.createdAt?.toMillis?.() ?? 0;\n        const bMs = b.createdAt?.toMillis?.() ?? 0;\n        return bMs - aMs;\n      });\n      callback(checklists);\n    },\n    (err) => console.error(\"[subscribeToChecklists]\", err.message)\n  );\n}\nexport function computeStats(checklists) {\n  let todo = 0;\n  let completed = 0;\n  let overdue = 0;\n  const today = (/* @__PURE__ */ new Date()).toISOString().slice(0, 10);\n  checklists.forEach((cl) => {\n    cl.items.forEach((item) => {\n      if (item.completed) completed++;\n      else {\n        todo++;\n        if (item.dueDate && item.dueDate < today) overdue++;\n      }\n    });\n  });\n  return { total: todo + completed, todo, completed, overdue };\n}\n\n//# sourceMappingURL=data:application/json;base64,"
