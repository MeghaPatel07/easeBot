          "content": {
            "size": -1,
            "mimeType": "text/javascript",
            "text": "export const TIER_LIMITS = {\n  guest: {\n    monthlyTokenPool: 0,\n    dailyTokenCap: 0,\n    topUpAvailable: false,\n    maxActiveReminders: 0,\n    reminderChannels: [],\n    chatRetentionDays: 0,\n    chatSearchable: false,\n    chatExportable: false,\n    maxProjects: 0,\n    notesAccess: \"view\",\n    exportFormats: [],\n    shareableLinks: false,\n    imageWatermark: true,\n    priorityRouting: false,\n    priorityVoiceQueue: false,\n    maxChecklists: 0\n  },\n  free: {\n    monthlyTokenPool: 3e5,\n    dailyTokenCap: 5e4,\n    topUpAvailable: false,\n    maxActiveReminders: 3,\n    reminderChannels: [\"email\"],\n    chatRetentionDays: 30,\n    chatSearchable: false,\n    chatExportable: false,\n    maxProjects: 1,\n    notesAccess: \"full\",\n    exportFormats: [\"pdf\"],\n    shareableLinks: false,\n    imageWatermark: true,\n    priorityRouting: false,\n    priorityVoiceQueue: false,\n    maxChecklists: 5\n  },\n  pro: {\n    monthlyTokenPool: 3e6,\n    dailyTokenCap: 3e5,\n    topUpAvailable: true,\n    maxActiveReminders: null,\n    reminderChannels: [\"email\", \"whatsapp\"],\n    chatRetentionDays: null,\n    chatSearchable: true,\n    chatExportable: false,\n    maxProjects: 2,\n    notesAccess: \"full\",\n    exportFormats: [\"pdf\", \"csv\"],\n    shareableLinks: false,\n    imageWatermark: false,\n    priorityRouting: false,\n    priorityVoiceQueue: false,\n    maxChecklists: null\n  },\n  promax: {\n    monthlyTokenPool: 8e6,\n    dailyTokenCap: 8e5,\n    topUpAvailable: true,\n    maxActiveReminders: null,\n    reminderChannels: [\"email\", \"whatsapp\", \"sms\"],\n    chatRetentionDays: null,\n    chatSearchable: true,\n    chatExportable: true,\n    maxProjects: 5,\n    notesAccess: \"full\",\n    exportFormats: [\"pdf\", \"csv\"],\n    shareableLinks: true,\n    imageWatermark: false,\n    priorityRouting: true,\n    priorityVoiceQueue: true,\n    maxChecklists: null\n  }\n};\nexport function resolveTier(profile) {\n  if (!profile) return \"guest\";\n  const raw = profile.tierMirror ?? profile.plan;\n  if (raw === \"pro\" || raw === \"promax\" || raw === \"free\") return raw;\n  if (profile.isPremium) return \"pro\";\n  return \"free\";\n}\nexport function getLimits(tier) {\n  return TIER_LIMITS[tier];\n}\nexport function formatTokenCount(n) {\n  if (n == null || isNaN(n)) return \"0\";\n  if (n >= 1e6) return `${(n / 1e6).toFixed(n % 1e6 === 0 ? 0 : 1)}M`;\n  if (n >= 1e3) return `${(n / 1e3).toFixed(n % 1e3 === 0 ? 0 : 1)}K`;\n  return n.toString();\n}\nexport function tierLabel(tier) {\n  switch (tier) {\n    case \"guest\":\n      return \"Guest\";\n    case \"free\":\n      return \"Free\";\n    case \"pro\":\n      return \"Pro\";\n    case \"promax\":\n      return \"Pro Max\";\n  }\n}\nexport function upgradeTier(tier) {\n  switch (tier) {\n    case \"guest\":\n      return \"free\";\n    case \"free\":\n      return \"pro\";\n    case \"pro\":\n      return \"promax\";\n    case \"promax\":\n      return null;\n  }\n}\n\n//# sourceMappingURL=data:application/json;base64,"
