olors {\\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-opacity {\\n  transition-property: opacity;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-shadow {\\n  transition-property: box-shadow;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.transition-transform {\\n  transition-property: transform;\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n  transition-duration: 150ms;\\n}\\n.duration-1000 {\\n  transition-duration: 1000ms;\\n}\\n.duration-150 {\\n  transition-duration: 150ms;\\n}\\n.duration-200 {\\n  transition-duration: 200ms;\\n}\\n.duration-300 {\\n  transition-duration: 300ms;\\n}\\n.duration-500 {\\n  transition-duration: 500ms;\\n}\\n.duration-700 {\\n  transition-duration: 700ms;\\n}\\n.ease-in-out {\\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  transition-timing-function: linear;\\n}\\n@keyframes enter {\\n\\n  from {\\n    opacity: var(--tw-enter-opacity, 1);\\n    transform: translate3d(var(--tw-enter-translate-x, 0), var(--tw-enter-translate-y, 0), 0) scale3d(var(--tw-enter-scale, 1), var(--tw-enter-scale, 1), var(--tw-enter-scale, 1)) rotate(var(--tw-enter-rotate, 0));\\n  }\\n}\\n@keyframes exit {\\n\\n  to {\\n    opacity: var(--tw-exit-opacity, 1);\\n    transform: translate3d(var(--tw-exit-translate-x, 0), var(--tw-exit-translate-y, 0), 0) scale3d(var(--tw-exit-scale, 1), var(--tw-exit-scale, 1), var(--tw-exit-scale, 1)) rotate(var(--tw-exit-rotate, 0));\\n  }\\n}\\n.animate-in {\\n  animation-name: enter;\\n  animation-duration: 150ms;\\n  --tw-enter-opacity: initial;\\n  --tw-enter-scale: initial;\\n  --tw-enter-rotate: initial;\\n  --tw-enter-translate-x: initial;\\n  --tw-enter-translate-y: initial;\\n}\\n.fade-in {\\n  --tw-enter-opacity: 0;\\n}\\n.fade-in-0 {\\n  --tw-enter-opacity: 0;\\n}\\n.fade-in-80 {\\n  --tw-enter-opacity: 0.8;\\n}\\n.zoom-in-95 {\\n  --tw-enter-scale: .95;\\n}\\n.slide-in-from-bottom-2 {\\n  --tw-enter-translate-y: 0.5rem;\\n}\\n.slide-in-from-top-1 {\\n  --tw-enter-translate-y: -0.25rem;\\n}\\n.slide-in-from-top-2 {\\n  --tw-enter-translate-y: -0.5rem;\\n}\\n.duration-1000 {\\n  animation-duration: 1000ms;\\n}\\n.duration-150 {\\n  animation-duration: 150ms;\\n}\\n.duration-200 {\\n  animation-duration: 200ms;\\n}\\n.duration-300 {\\n  animation-duration: 300ms;\\n}\\n.duration-500 {\\n  animation-duration: 500ms;\\n}\\n.duration-700 {\\n  animation-duration: 700ms;\\n}\\n.ease-in-out {\\n  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\\n}\\n.ease-linear {\\n  animation-timing-function: linear;\\n}\\n.paused {\\n  animation-play-state: paused;\\n}\\n/* iOS safe-area helpers */\\n.h-dvh-safe {\\n    height: 100vh;\\n    height: 100dvh;\\n  }\\n.\\\\[-ms-overflow-style\\\\:none\\\\] {\\n  -ms-overflow-style: none;\\n}\\n.\\\\[scrollbar-width\\\\:none\\\\] {\\n  scrollbar-width: none;\\n}\\n.\\\\[share\\\\:product\\\\] {\\n  share: product;\\n}\\n\\n/* System font stack — matches Claude's clean sans-serif look */\\n\\n/* Shared soft text color — follows theme foreground */\\n.text-soft {\\n  color: hsl(var(--foreground) / 0.82);\\n}\\n\\n/* ──────────────────────────────────────────────────────────────────────────\\n   EaseBot — Final Chatbot theme (Figma: Final-Chatbot)\\n   Background #090807, bronze accent #A17A63, white text,\\n   glass sidebar (#D07A46 @ 2% fill, #603B25 @ 52% stroke),\\n   warm radial bloom, subtle grid overlay.\\n   ────────────────────────────────────────────────────────────────────────── */\\n\\n/* ─── SOURCE TOKENS ──────────────────────────────────────────────────────\\n   Namespaced per-theme palettes. These are the single source of truth.\\n   Each theme defines its own --dark-* / --light-* tokens independently —\\n   no variable NAME is shared between the two source palettes.\\n\\n   The semantic aliases below (--background, --primary, --border, ...) are\\n   the public API used by Tailwind and every component. `.dark` and `.light`\\n   swap those aliases to the appropriate source at runtime.\\n\\n   Adding a token → add it to BOTH source blocks (--dark-* AND --light-*),\\n   then add the alias line to the semantic block AND to both .dark / .light\\n   orchestrator blocks below.\\n   ──────────────────────────────────────────────────────────────────────── */\\n\\n/* Light-theme readability overrides: low-alpha foreground is too faint on ivory.\\n   Dark mode keeps the Tailwind-generated alpha; light mode bumps contrast. */\\n.light .text-foreground\\\\/45 {\\n  color: hsl(var(--foreground));\\n}\\n\\n.light .text-foreground\\\\/40 {\\n  color: hsl(var(--foreground) / 0.75);\\n}\\n\\n.light .text-foreground\\\\/35 {\\n  color: hsl(var(--foreground) / 0.70);\\n}\\n\\n.light .text-foreground\\\\/30 {\\n  color: hsl(var(--foreground) / 0.65);\\n}\\n\\n.light .text-foreground\\\\/25 {\\n  color: hsl(var(--foreground) / 0.60);\\n}\\n\\n/* Chat message text — darker coffee in light mode for readability.\\n   Applies to bot-message prose and user-message bubble when tagged. */\\n.light .chat-msg-text,\\n.light .chat-msg-text :is(p, h1, h2, h3, h4, li, strong, em, blockquote, code) {\\n  color: hsl(22 9.38% 10.33%);\\n}\\n\\n/* Sidebar chat thread titles — deep coffee in light mode for readability. */\\n.light .thread-title,\\n.light .thread-title:hover {\\n  color: hsl(21 41% 16% / 0.94);\\n}\\n\\n/* ──────────────────────────────────────────────────────────────────────────\\n   BACKGROUND SHELL — grid + radial bronze bloom on #090807\\n   Applied via .gradient-bg (already used by Index.tsx shell).\\n   ────────────────────────────────────────────────────────────────────────── */\\n\\n@keyframes gradient-shift {\\n\\n  0%,\\n  100% {\\n    background-position: 0% 50%;\\n  }\\n\\n  50% {\\n    background-position: 100% 50%;\\n  }\\n}\\n\\n@keyframes float {\\n\\n  0%,\\n  100% {\\n    transform: translateY(0px);\\n  }\\n\\n  50% {\\n    transform: translateY(-10px);\\n  }\\n}\\n\\n@keyframes pulse-glow {\\n\\n  0%,\\n  100% {\\n    box-shadow: 0 0 20px rgb(var(--bronze) / 0.2);\\n  }\\n\\n  50% {\\n    box-shadow: 0 0 40px rgb(var(--bronze) / 0.4);\\n  }\\n}\\n\\n.gradient-bg,\\n.gradient-bg-expanded {\\n  position: relative;\\n  background-color: hsl(var(--background));\\n  isolation: isolate;\\n  /* Prevent mobile overscroll bounce */\\n  overscroll-behavior: none;\\n}\\n\\n/* Grid overlay — grid-stroke + grid-alpha swap per theme.\\n   Mask confines the grid to the top-right + bottom-left corners with a\\n   fadeout, matching the same layout across light and dark modes. */\\n.gradient-bg::before,\\n.gradient-bg-expanded::before {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  pointer-events: none;\\n  z-index: 0;\\n  background-image:\\n    linear-gradient(to right, rgb(var(--grid-stroke) / var(--grid-alpha)) 1px, transparent 1px),\\n    linear-gradient(to bottom, rgb(var(--grid-stroke) / var(--grid-alpha)) 1px, transparent 1px);\\n  background-size: 26px 26px;\\n  mask-image:\\n    radial-gradient(ellipse 85% 70% at 100% 0%, #000 10%, transparent 85%),\\n    radial-gradient(ellipse 110% 90% at 0% 100%, #000 15%, transparent 90%);\\n  -webkit-mask-image:\\n    radial-gradient(ellipse 85% 70% at 100% 0%, #000 10%, transparent 85%),\\n    radial-gradient(ellipse 110% 90% at 0% 100%, #000 15%, transparent 90%);\\n  mask-composite: add;\\n  -webkit-mask-composite: source-over;\\n}\\n\\n/* Corner radial blooms — theme-swapped via --grad-bg-bloom\\n   (dark: bronze → near-black; light: bronze → ivory) */\\n.gradient-bg::after,\\n.gradient-bg-expanded::after {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  pointer-events: none;\\n  z-index: 0;\\n  background: var(--grad-bg-bloom);\\n  filter: blur(120px);\\n}\\n\\n/* Dark mode: custom bronze corner blooms — top-right + bottom-left */\\n.dark .gradient-bg::after,\\n.dark .gradient-bg-expanded::after {\\n  background:\\n    radial-gradient(ellipse 55% 80% at 95% 0%, rgb(208 123 70 / 30%) 0%, rgb(var(--dark-sidebar-fill) / 0.22) 30%, rgb(10 10 10 / 0) 70%),\\n    radial-gradient(ellipse 75% 70% at 5% 100%, rgb(208 123 70 / 38%) 0%, rgb(var(--dark-sidebar-fill) / 0.22) 30%, rgb(10 10 10 / 0) 70%);\\n}\\n\\n/* keep content above bg overlays — but skip fixed-position children\\n   (sidebar, backdrop overlay) so they aren't forced to position:relative. */\\n.gradient-bg>*:not([class~=\\\"fixed\\\"]),\\n.gradient-bg-expanded>*:not([class~=\\\"fixed\\\"]) {\\n  position: relative;\\n  z-index: 1;\\n}\\n\\n.float-animation {\\n  animation: float 6s ease-in-out infinite;\\n}\\n\\n.pulse-glow {\\n  animation: pulse-glow 3s ease-in-out infinite;\\n}\\n\\n/* ──────────────────────────────────────────────────────────────────────────\\n   GLASS SURFACES\\n   ────────────────────────────────────────────────────────────────────────── */\\n\\n/* Generic glass — used by dialogs, popovers, cards.\\n   Background, border, and shadow are now applied via Tailwind on each component\\n   so they can be tuned per-modal. This class only provides the backdrop-filter. */\\n.glass-panel {\\n  backdrop-filter: blur(40px) saturate(150%);\\n  -webkit-backdrop-filter: blur(40px) saturate(150%);\\n}\\n\\n/* Sidebar glass (Figma spec #5: #D07A46 @ 2%, #603B25 @ 52%) */\\n.glass-sidebar {\\n  backdrop-filter: blur(24px) saturate(140%);\\n  -webkit-backdrop-filter: blur(24px) saturate(140%);\\n  background:\\n    linear-gradient(180deg, rgb(var(--sidebar-fill) / 0.03) 0%, rgb(var(--sidebar-fill) / 0.02) 100%);\\n  border: 1px solid rgb(var(--sidebar-stroke) / 0.52);\\n  box-shadow:\\n    0 4px 4px rgba(0, 0, 0, 0.25),\\n    inset 0 1px 0 rgba(255, 255, 255, 0.06);\\n}\\n\\n/* Active sidebar item chip (Figma spec #6: bronze glass chip) */\\n.glass-sidebar-chip {\\n  backdrop-filter: blur(16px) saturate(130%);\\n  -webkit-backdrop-filter: blur(16px) saturate(130%);\\n  background: linear-gradient(180deg, rgb(var(--bronze) / 0.35) 0%, rgb(var(--bronze) / 0.22) 100%);\\n  border: 1px solid rgba(0, 0, 0, 0.35);\\n  box-shadow:\\n    inset 0 1px 0 rgba(255, 255, 255, 0.12),\\n    0 2px 12px rgba(0, 0, 0, 0.4);\\n}\\n\\n/* Chat body bubble / floating button (Figma spec #8) */\\n.glass-chat {\\n  backdrop-filter: blur(12px);\\n  -webkit-backdrop-filter: blur(12px);\\n  background-color: rgba(255, 255, 255, 0.03);\\n  border: 1px solid rgba(255, 255, 255, 0.10);\\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);\\n  color: #FFFFFF;\\n}\\n\\n/* Elegant heading */\\n.elegant-heading {\\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\\n  font-weight: 700;\\n  font-style: italic;\\n  letter-spacing: -0.01em;\\n}\\n\\n/* Bronze scrollbar */\\n.custom-scrollbar::-webkit-scrollbar {\\n  width: 4px;\\n}\\n\\n.custom-scrollbar::-webkit-scrollbar-track {\\n  background: transparent;\\n}\\n\\n.custom-scrollbar::-webkit-scrollbar-thumb {\\n  background: rgb(var(--bronze) / 0.3);\\n  border-radius: 10px;\\n}\\n\\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\\n  background: rgb(var(--bronze) / 0.5);\\n}\\n\\n.scrollbar-hide::-webkit-scrollbar {\\n  display: none;\\n}\\n\\n.scrollbar-hide {\\n  -ms-overflow-style: none;\\n  scrollbar-width: none;\\n}\\n\\n/* Bronze glow on input focus */\\n.input-glow:focus-within {\\n  box-shadow: var(--shadow-input-focus);\\n}\\n\\n/* Bot avatar shimmer */\\n@keyframes avatar-shimmer {\\n\\n  0%,\\n  100% {\\n    box-shadow: 0 0 8px rgb(var(--bronze) / 0.35);\\n  }\\n\\n  50% {\\n    box-shadow: 0 0 16px rgb(var(--bronze) / 0.55);\\n  }\\n}\\n\\n.bot-avatar {\\n  animation: avatar-shimmer 3s ease-in-out infinite;\\n}\\n\\n/* Smooth message entrance */\\n@keyframes msg-in {\\n  from {\\n    opacity: 0;\\n    transform: translateY(8px);\\n  }\\n\\n  to {\\n    opacity: 1;\\n    transform: translateY(0);\\n  }\\n}\\n\\n.msg-enter {\\n  animation: msg-in 0.3s ease-out;\\n}\\n\\n/* Subtle noise texture overlay for depth */\\n.noise-overlay::before {\\n  content: '';\\n  position: absolute;\\n  inset: 0;\\n  opacity: 0.02;\\n  background-image: url(\\\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\\\");\\n  pointer-events: none;\\n  z-index: 0;\\n}\\n\\n/* Image generation skeleton shimmer */\\n@keyframes shimmer {\\n  0% {\\n    transform: translateX(-100%);\\n  }\\n\\n  100% {\\n    transform: translateX(100%);\\n  }\\n}\\n\\n@keyframes progress {\\n  0% {\\n    width: 0%;\\n  }\\n\\n  50% {\\n    width: 80%;\\n  }\\n\\n  100% {\\n    width: 100%;\\n  }\\n}\\n\\n/* Thread title gradient mask (hover overflow menu) */\\n.thread-item .thread-title {\\n  mask-image: linear-gradient(to right, black 100%, black 100%);\\n  -webkit-mask-image: linear-gradient(to right, black 100%, black 100%);\\n  transition: mask-image 0.2s ease, -webkit-mask-image 0.2s ease;\\n}\\n\\n.thread-item:hover .thread-title {\\n  mask-image: linear-gradient(to right, black calc(100% - 36px), transparent calc(100% - 4px));\\n  -webkit-mask-image: linear-gradient(to right, black calc(100% - 36px), transparent calc(100% - 4px));\\n}\\n\\n/* Active sidebar item bronze indicator */\\n.sidebar-active-indicator {\\n  position: relative;\\n}\\n\\n.sidebar-active-indicator::before {\\n  content: '';\\n  position: absolute;\\n  left: 0;\\n  top: 25%;\\n  height: 50%;\\n  width: 3px;\\n  background: hsl(var(--primary));\\n  border-radius: 0 3px 3px 0;\\n}\\n\\n/* Floral decorative corner overlay (disabled — kept for future use) */\\n.floral-overlay::after {\\n  content: '';\\n  position: absolute;\\n  top: 0;\\n  right: 0;\\n  width: 300px;\\n  height: 400px;\\n  background-size: contain;\\n  background-repeat: no-repeat;\\n  background-position: top right;\\n  pointer-events: none;\\n  z-index: 0;\\n  opacity: 1;\\n}\\n\\n/* Glassmorphism action card (quick prompts etc.) */\\n.glass-action-card {\\n  backdrop-filter: blur(16px);\\n  -webkit-backdrop-filter: blur(16px);\\n  background: var(--glass-bg);\\n  border: 1px solid var(--glass-border);\\n  transition: all 0.3s ease;\\n}\\n\\n.glass-action-card:hover {\\n  background: var(--glass-bg-hover);\\n  border-color: var(--glass-border-hover);\\n  transform: translateY(-2px);\\n  box-shadow: var(--shadow-card-hover);\\n}\\n\\n/* Event chip pill */\\n.event-chip {\\n  backdrop-filter: blur(8px);\\n  -webkit-backdrop-filter: blur(8px);\\n  background: var(--glass-bg);\\n  border: 1px solid var(--glass-border);\\n  transition: all 0.2s ease;\\n}\\n\\n.event-chip:hover {\\n  background: var(--glass-bg-hover);\\n  border-color: var(--glass-border-hover);\\n}\\n\\n.file\\\\:border-0::file-selector-button {\\n  border-width: 0px;\\n}\\n\\n.file\\\\:bg-transparent::file-selector-button {\\n  background-color: transparent;\\n}\\n\\n.file\\\\:text-sm::file-selector-button {\\n  font-size: 0.875rem;\\n  line-height: 1.25rem;\\n}\\n\\n.file\\\\:font-medium::file-selector-button {\\n  font-weight: 500;\\n}\\n\\n.file\\\\:text-foreground::file-selector-button {\\n  --tw-text-opacity: 1;\\n  color: hsl(var(--foreground) / var(--tw-text-opacity, 1));\\n}\\n\\n.placeholder\\\\:text-foreground\\\\/25::-moz-placeholder {\\n  color: hsl(var(--foreground) / 0.25);\\n}\\n\\n.placeholder\\\\:text-foreground\\\\/25::placeholder {\\n  color: hsl(var(--foreground) / 0.25);\\n}\\n\\n.placeholder\\\\:text-foreground\\\\/30::-moz-placeholder {\\n  color: hsl(var(--foreground) / 0.3);\\n}\\n\\n.placeholder\\\\:text-foreground\\\\/30::placeholder {\\n  color: hsl(var(--foreground) / 0.3);\\n}\\n\\n.placeholder\\\\:text-foreground\\\\/40::-moz-placeholder {\\n  color: hs