            "size": -1,
            "mimeType": "text/javascript",
            "text": "import {\n  collection,\n  doc,\n  setDoc,\n  updateDoc,\n  deleteDoc,\n  onSnapshot,\n  serverTimestamp,\n  getDoc\n} from \"/node_modules/.vite/deps/firebase_firestore.js?v=17f5c807\";\nimport { db } from \"/src/lib/firebase.ts\";\nfunction shoppingListsCol(userId) {\n  return collection(db, \"users\", userId, \"shoppingLists\");\n}\nfunction shoppingListDoc(userId, listId) {\n  return doc(db, \"users\", userId, \"shoppingLists\", listId);\n}\nexport function subscribeToShoppingLists(userId, callback) {\n  return onSnapshot(\n    shoppingListsCol(userId),\n    (snapshot) => {\n      const lists = snapshot.docs.map((d) => ({ ...d.data() })).sort((a, b) => {\n        const aMs = a.createdAt?.toMillis?.() ?? 0;\n        const bMs = b.createdAt?.toMillis?.() ?? 0;\n        return bMs - aMs;\n      });\n      callback(lists);\n    },\n    (err) => console.error(\"[subscribeToShoppingLists]\", err.message)\n  );\n}\nexport async function createShoppingList(userId, title) {\n  const id = crypto.randomUUID();\n  const now = serverTimestamp();\n  const list = { id, userId, title, items: [], createdAt: now, updatedAt: now };\n  await setDoc(shoppingListDoc(userId, id), list);\n  return list;\n}\nexport async function deleteShoppingList(userId, listId) {\n  await deleteDoc(shoppingListDoc(userId, listId));\n}\nexport async function addShoppingItem(userId, listId, item) {\n  const ref = shoppingListDoc(userId, listId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items;\n  items.push({ id: crypto.randomUUID(), ...item });\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function updateShoppingItem(userId, listId, itemId, updates) {\n  const ref = shoppingListDoc(userId, listId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.map(\n    (item) => item.id === itemId ? { ...item, ...updates } : item\n  );\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function deleteShoppingItem(userId, listId, itemId) {\n  const ref = shoppingListDoc(userId, listId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.filter((i) => i.id !== itemId);\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\nexport async function toggleItemPurchased(userId, listId, itemId) {\n  const ref = shoppingListDoc(userId, listId);\n  const snap = await getDoc(ref);\n  if (!snap.exists()) return;\n  const items = snap.data().items.map(\n    (item) => item.id === itemId ? { ...item, purchased: !item.purchased } : item\n  );\n  await updateDoc(ref, { items, updatedAt: serverTimestamp() });\n}\n\n//# sourceMappingURL=data:application/json;base64,"
