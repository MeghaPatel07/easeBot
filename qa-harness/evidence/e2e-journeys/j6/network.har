            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_API_BASE_URL\": \"http://localhost:3001\", \"VITE_APP_VERSION\": \"dev\", \"VITE_ENABLE_PAYMENT\": \"false\", \"VITE_EXCHANGE_RATE_API_KEY\": \"ce1384b9a93b5aad0e758d61\", \"VITE_FIREBASE_API_KEY\": \"AIzaSyD3f6VSZooeyqt_8PXJveislOH7Mrn6X94\", \"VITE_FIREBASE_APP_ID\": \"1:938953154391:web:a0d08bac565b9cbc046812\", \"VITE_FIREBASE_AUTH_DOMAIN\": \"wedding-ease-dc99a.firebaseapp.com\", \"VITE_FIREBASE_MESSAGING_SENDER_ID\": \"938953154391\", \"VITE_FIREBASE_PROJECT_ID\": \"wedding-ease-dc99a\", \"VITE_FIREBASE_STORAGE_BUCKET\": \"wedding-ease-dc99a.appspot.com\", \"VITE_IP_GEOLOCATION_API_KEY\": \"f92eea25a17246a09563543976ca23d7\", \"VITE_POSTHOG_ENABLED\": \"true\", \"VITE_POSTHOG_HOST\": \"/ingest\", \"VITE_POSTHOG_KEY\": \"phc_C3dxDiWMwVzdTWbXbDXvp98L9XCm2qFTJtcgxenkkBXV\"};import { auth } from \"/src/lib/firebase.ts\";\nconst API_BASE = import.meta.env.VITE_API_BASE_URL ?? \"https://backend.theweddingbot.ai\";\nasync function getAuthToken() {\n  const user = auth.currentUser;\n  if (!user) return null;\n  return user.getIdToken();\n}\nexport async function requestTTS(req) {\n  const token = await getAuthToken();\n  const headers = { \"Content-Type\": \"application/json\" };\n  if (token) headers[\"Authorization\"] = `Bearer ${token}`;\n  const res = await fetch(`${API_BASE}/api/tts`, {\n    method: \"POST\",\n    headers,\n    body: JSON.stringify(req)\n  });\n  if (!res.ok) {\n    const err = await res.json().catch(() => ({}));\n    throw new Error(err.error ?? `TTS request failed: ${res.status}`);\n  }\n  const blob = await res.blob();\n  return URL.createObjectURL(blob);\n}\n\n//# sourceMappingURL=data:application/json;base64,"
