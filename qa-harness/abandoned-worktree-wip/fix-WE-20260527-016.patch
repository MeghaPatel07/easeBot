+// Canonical occasion list mirrors the chips rendered in Wedding-Ease-Viva-Chat
+// src/pages/Index.tsx (`occasions`). Treated as case-insensitive; any unknown
+// value is still injected as raw context so the LLM has a chance to use it,
+// but no canonical name is asserted. Keep this list in sync if the UI changes.
+const CANONICAL_OCCASIONS = new Set(
+  [
+    'Engagement', 'Haldi', 'Mehendi', 'Sangeet', 'Cocktail', 'Wedding',
+    'Reception', 'Baraat', 'Vidaai', 'Roka', 'Sagai', 'Ganesh Puja',
+    'Bachelor Party', 'Bridal Shower', 'Destination', 'Festive',
+  ].map((s) => s.toLowerCase()),
+)
+
+function buildOccasionSystemSuffix(occasion?: string): string {
+  if (!occasion) return ''
+  const trimmed = occasion.trim()
+  if (!trimmed) return ''
+  const isCanonical = CANONICAL_OCCASIONS.has(trimmed.toLowerCase())
+  const canonicalHint = isCanonical
+    ? ` This is a recognised Indian-wedding occasion — anchor your reply in its rituals, palette, attire, and customs (e.g. Haldi → yellow/marigold; Sangeet → music/dance; Mehendi → henna; etc.).`
+    : ' Treat this as the active event context for the turn.'
+  return `\nOCCASION CONTEXT: The user has selected the occasion '${trimmed}' in the composer. Tailor your response — outfit suggestions, planning tips, palette, rituals, and inspiration — to this specific occasion unless the user's message clearly overrides it.${canonicalHint}`
+}
+
