+// Treat KEY as missing when it's an empty string or a placeholder. Prevents the
+// SDK from booting on `phc_` / `your-key-here` / etc. — which would otherwise
+// trigger the /ingest 404 storm reported in WE-20260527-001.
+const KEY_VALID = typeof KEY === 'string' && /^phc_[A-Za-z0-9]{20,}$/.test(KEY)
+
 let ready = false
 
 export function initAnalytics(): PostHog | null {
   if (import.meta.env.DEV) {
     ;(window as unknown as { posthog: PostHog }).posthog = posthog
