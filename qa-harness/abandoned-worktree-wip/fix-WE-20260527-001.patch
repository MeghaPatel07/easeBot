+    ;(window as unknown as { __phDebug: { enabled: boolean; key: string | undefined; host: string; keyValid: boolean } }).__phDebug = {
       enabled: ENABLED,
       key: KEY,
       host: HOST,
+      keyValid: KEY_VALID,
+    }
+  }
+  if (!ENABLED || !KEY_VALID) {
+    if (import.meta.env.DEV) {
+      // One-line breadcrumb so devs can see why no PH events fire.
+      console.info(
+        `[analytics] PostHog disabled (enabled=${ENABLED}, keyValid=${KEY_VALID}). Set VITE_POSTHOG_ENABLED=true and a valid VITE_POSTHOG_KEY to enable.`,
+      )
     }
+    return null
   }
-  if (!ENABLED || !KEY) return null
   if (ready) return posthog
   posthog.init(KEY, {
