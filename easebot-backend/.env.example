# =============================================================================
# Easebot backend .env.example
# Copy to .env and fill in values. Vars without defaults are REQUIRED.
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# Number of reverse-proxy hops in front of Express (Railway/Render/Fly/nginx…).
# Express uses this to derive a trustworthy req.ip from X-Forwarded-For for
# IP-based rate limiting. DO NOT set this larger than the real number of proxies
# or clients can spoof their IP. 1 = one proxy (typical PaaS). 0 = no proxy
# (local dev). This is the canonical knob (WE-20260527-1004).
TRUST_PROXY_HOPS=1
# Legacy alias, still honoured when TRUST_PROXY_HOPS is unset. Prefer TRUST_PROXY_HOPS.
# TRUST_PROXY=1

# --- CORS allowlist (WE-20260527-248) ---
# Comma-separated list of exact browser origins permitted to call this API.
# Unknown origins (including reflective OPTIONS preflights) are rejected.
# Requests with no Origin header (curl, server-to-server, health probes) pass.
# Set this to your real frontend origin(s) in production, e.g.:
#   ALLOWED_ORIGINS=https://app.weddingease.ai,https://weddingease.ai
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080

# Frontend origin — used to redirect browser after PayU return/failure and
# other server-initiated redirects. REQUIRED for /payment/return handler.
FRONTEND_BASE_URL=http://localhost:8080

# --- Pipeline toggles ---
# true  → full pipeline: STT + language detection + translation
# false → skip STT & translation; treat all input as English
ENABLE_SPEECH_TRANSLATION=

# Agentic pipeline toggles
ENABLE_PROMPT_ARCHITECT=true
ENABLE_IMAGE_UPSCALE=true

# In-process schedulers (set to 'false' to disable on a specific instance)
ENABLE_REMINDER_SCHEDULER=true
ENABLE_GUEST_CLEANUP=true
ENABLE_SUBSCRIPTION_SCHEDULER=true

# --- Azure AI Foundry — GPT-4o chat ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_DEPLOYMENT_NAME=

# --- Azure AI Foundry — Image Generation (GPT-Image-1.5 primary, GPT-Image-1 fallback) ---
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_GPT_IMAGE_15_DEPLOYMENT=gpt-image-1-5
AZURE_GPT_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_GPT_IMAGE_API_VERSION=2025-04-01-preview

# --- Azure AI Speech — STT + Continuous Language ID ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Azure AI Translator ---
# Get from: Azure Portal → Translator resource → Keys and Endpoint
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_REGION=

# --- Firebase Client SDK (used by tokenMeter, subscriptionStateMachine, etc) ---
# Project Settings → General → Your apps → Web app → SDK setup and configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Firebase Admin SDK (only for server-only admin flows — NOT used by tokenMeter) ---
# Either a file path or inline JSON. If neither is set, the SDK falls back to
# GOOGLE_APPLICATION_CREDENTIALS (below).
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_APPLICATION_CREDENTIALS=

# Require fresh ID tokens on every request (slower, safer)
FIREBASE_CHECK_REVOKED=false

# --- Algolia — server-side product search (stylist mode) ---
# Use the Search-Only API key (not Admin key)
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=

# --- Google Gemini — image generation primary + TTS ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- PayU (Sprint 2 live) ---
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_WEBHOOK_SECRET=
# PayU POSTs back to these URLs (form POST, not GET). They MUST point at the
# backend POST /api/payment/return endpoint — NOT the frontend — because the
# Vite/SPA dev server 404s on POSTs. handleReturn verifies the PayU hash and
# then 302-redirects the browser to ${FRONTEND_BASE_URL}/payment/success or
# /payment/failure. Use the same URL for both success and failure — the
# handler branches on payload.status.
PAYU_RETURN_URL=http://localhost:3001/api/payment/return
PAYU_FAILURE_URL=http://localhost:3001/api/payment/return

# --- Currency / exchange rate (server-side) ---
# Get from: https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=
# Optional override for the exchange rate API base URL.
EXCHANGE_RATE_API_URL=

# --- Guest quota salt (used to hash IPs for rate-limited guest tracking) ---
# REQUIRED in production — the in-code default is insecure.
GUEST_IP_SALT=

# --- Legal entity (invoice seller block — Decision D3) ---
# Required fields: NAME + COUNTRY. Others are optional but recommended for IN.
# If COUNTRY != 'IN', every invoice uses the INTL_NA tax branch.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_COUNTRY=
LEGAL_ENTITY_STATE=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_GSTIN=

# --- Email / SMTP (invoice delivery + password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
REMINDER_FROM_EMAIL=

# --- WhatsApp reminder (optional — whatsapp reminder feature) ---
WASENDER_API_KEY=
WASENDER_API_URL=

# --- PostHog analytics (server) ---
# Project API key from app.posthog.com → Project Settings.
POSTHOG_PROJECT_KEY=
# US cloud default. Use https://eu.i.posthog.com for EU region.
POSTHOG_HOST=https://us.i.posthog.com
# Hard kill-switch. Must be "true" AND NODE_ENV=production for capture to fire.
POSTHOG_ENABLED=false
