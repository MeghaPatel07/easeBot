{
  "name": "easebot-backend",
  "version": "1.0.0",
  "description": "WeddingEase Viva — AI backend server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --transpile-only src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:phase1:cache": "ts-node --transpile-only src/lib/__tests__/userPrefsCache.test.ts",
    "test:phase1:controller": "ts-node --transpile-only src/controllers/__tests__/transcribeController.test.ts",
    "test:phase1": "npm run test:phase1:cache && npm run test:phase1:controller",
    "test:phase2:phrases": "ts-node --transpile-only src/services/__tests__/sttPhraseList.test.ts",
    "test:phase2": "npm run test:phase2:phrases",
    "test:langfix": "ts-node --transpile-only src/pipeline/__tests__/inbound.test.ts",
    "test:all": "npm run test:phase1 && npm run test:phase2 && npm run test:langfix"
  },
  "dependencies": {
    "@types/ffmpeg-static": "^3.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/nodemailer": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^12.7.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "lru-cache": "^10.4.3",
    "microsoft-cognitiveservices-speech-sdk": "^1.38.0",
    "nodemailer": "^8.0.5",
    "openai": "^4.47.1",
    "pdfkit": "^0.18.0",
    "posthog-node": "^5.29.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/sharp": "^0.31.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
